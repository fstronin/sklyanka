    <!-- ===== Система ===== -->
    <!--
      Строки «Часы Huawei» здесь нет: интеграция с часами отложена до пост-MVP
      (`ADR-0009`), и подпись о состоянии связи, которое не может измениться, была бы
      ложью. Строки вернутся вместе с Wear Engine.
    -->

    <string name="settings_permissions">Разрешения и автозапуск</string>
    <!--
      Сколько разрешений не выдано (НФТ-8). Одно — словом, как в макете: строка читается
      как утверждение, а «1 не выдано» читается как отчёт. Через две строки, а не через
      plurals: в русском форма «одно» приходится и на 21, и на 31, и подпись «Одно
      не выдано» при двадцати одном отказе была бы ложью (lint ImpliedQuantity).
    -->
    <string name="settings_permissions_denied_one">Одно не выдано</string>
    <string name="settings_permissions_denied_many">%1$d не выдано</string>
    <!-- НАП-20: состояние автозапуска EMUI система не отдаёт, и приложение об этом говорит. -->
    <string name="settings_permissions_granted_manual">Выданы · автозапуск проверьте вручную</string>
