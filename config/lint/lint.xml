<?xml version="1.0" encoding="UTF-8"?>
<!--
  Android Lint отвечает за платформенное (TDD §5.1):
  NewApi — ПЛ-1 и НФТ-38, minSdk 26;
  HardcodedText — НФТ-42, тексты живут в strings.xml;
  слияние манифестов — ПЛ-3, разрешение INTERNET не должно приезжать из зависимости.
-->
<lint>
    <issue id="NewApi" severity="error" />
    <issue id="InlinedApi" severity="error" />
    <issue id="HardcodedText" severity="error" />
    <issue id="ManifestOrder" severity="error" />
    <issue id="MissingApplicationIcon" severity="ignore" />
    <!-- Обновления зависимостей ведутся каталогом версий, а не подсказками lint. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="OldTargetApi" severity="ignore" />
</lint>
