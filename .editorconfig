root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = intellij_idea
# Compose-функции именуются с большой буквы — соглашение Compose, а не нарушение стиля.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Порядок и содержание импортов проверяет ktlint, но wildcard-импорты запрещены явно.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{xml,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
