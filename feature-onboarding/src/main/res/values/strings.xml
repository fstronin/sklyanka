<?xml version="1.0" encoding="utf-8"?>
<!--
  Тексты экрана разрешений EMUI.

  Раздел «Из макета» — дословно из `design/screens/Onboarding.dc.html` и
  `design/spec/03-screens.md`, раздел «Разрешения (онбординг)»: критерий приёмки 21 требует
  совпадения слово в слово. Русского текста в Kotlin-коде нет вообще (НФТ-42).

  Раздел «Сверх макета» — строки, которых в макетах нет. Каждая объяснена: экран задачи
  говорит о том, чего макет не нарисовал (запуск пробного напоминания, подтверждение
  третьего шага, запасной путь при неоткрывшемся системном разделе), и придумывать эти
  формулировки молча нельзя.
-->
<resources>

    <!-- ===== Из макета: дословно (критерий приёмки 21) ===== -->

    <string name="onboarding_title">Чтобы напоминания приходили вовремя</string>
    <string name="onboarding_intro">На прошивке EMUI система агрессивно выгружает фоновые приложения. Без трёх разрешений ниже приёмы будут приходить с опозданием или не приходить совсем.</string>

    <string name="onboarding_step_notifications">Уведомления</string>
    <!--
      Единственная строка раздела «Из макета», отступившая от макета дословно: слова
      «и на часах» сняты решением `ADR-0009` — интеграция с Wear Engine отложена
      до пост-MVP, и обещать карточку на часах первой версии нельзя. Макет не правится;
      слова вернутся вместе с часами.
    -->
    <string name="onboarding_step_notifications_caption">Карточка приёма на экране</string>

    <string name="onboarding_step_exact_alarms">Точные будильники</string>
    <string name="onboarding_step_exact_alarms_caption">Иначе Android сдвинет приём на удобное себе время — до получаса</string>

    <string name="onboarding_step_autostart">Автозапуск без ограничений</string>
    <string name="onboarding_step_autostart_caption">Настройки → Батарея → Запуск приложений → Склянка → вручную</string>

    <!-- Отметка выданного разрешения. Рядом с ней галочка — цвет не единственный носитель смысла (НФТ-33). -->
    <string name="onboarding_state_granted">Есть</string>

    <string name="onboarding_action_allow">Разрешить</string>
    <string name="onboarding_action_open_settings">Открыть настройки</string>

    <!--
      Плашка макета. Слово «тестовое» — из макета, и по критерию 21 менять его здесь нельзя.
      Спецификация (НАП-22, ПЛ-19) и соседний экран `WatchSetup` говорят «пробное»;
      расхождение вынесено в отчёт задачи и закрывается правкой макета, а не кода.
    -->
    <string name="onboarding_test_hint">Проверить можно сразу: пришлём тестовое напоминание через минуту.</string>

    <string name="onboarding_action_next">Дальше</string>
    <string name="onboarding_action_skip">Пропустить, настрою позже</string>

    <!-- ===== Сверх макета ===== -->

    <!--
      Подпись элемента, запускающего пробное напоминание.

      СТРОКА НЕ СОГЛАСОВАНА С ДИЗАЙНОМ — открытый вопрос SKL-14 (ОВ-50): макет обещает
      напоминание текстом и не содержит ни одного элемента, который бы его запустил.
      Образец взят у соседнего экрана: «Отправить пробную карточку» (`WatchSetup.dc.html`).
    -->
    <string name="onboarding_action_test_reminder">Отправить пробное напоминание</string>

    <!-- Подтверждение постановки: человек знает точное время, а не только «через минуту». -->
    <string name="onboarding_test_planned">Пробное напоминание придёт в %1$s</string>
    <string name="onboarding_test_time_pattern">HH:mm</string>

    <!--
      Почему третий шаг не бывает зелёным сам (НАП-20, ПЛ-18, критерий приёмки 7).
      Это не оговорка мелким шрифтом, а единственное, что приложение об этом шаге знает.
    -->
    <string name="onboarding_autostart_unverifiable">Проверить это приложение не может: что автозапуск настроен, покажет только пробное напоминание.</string>

    <!--
      Ручное подтверждение третьего шага (НАП-20, открытый вопрос ОВ-53).
      Переключателем, а не кнопкой: подтверждение обязано сниматься — нажатое по ошибке,
      оно иначе оставило бы человека с зелёным шагом, который он выдал себе сам.
    -->
    <string name="onboarding_autostart_confirm">Я настроил автозапуск</string>
    <string name="onboarding_autostart_confirm_caption">Записывается с ваших слов: приложение эту настройку не проверяет</string>

    <!-- Косвенные признаки. Слово «косвенный» в строке обязательно: оно и есть смысл (НАП-20). -->
    <string name="onboarding_hint_battery">Косвенный признак: оптимизация батареи для приложения снята</string>
    <string name="onboarding_hint_test_delivered">Косвенный признак: пробное напоминание недавно дошло</string>

    <!--
      Запасной путь: системный раздел не открылся (критерий приёмки 6).
      Не сообщение об ошибке — рабочая инструкция: интент этого экрана нестандартен
      и различается между прошивками (`docs/spec/01-platform.md` §6).
    -->
    <string name="onboarding_autostart_instructions">Системный раздел на этом устройстве не открылся. Откройте его вручную: Настройки → Батарея → Запуск приложений → Склянка → вручную.</string>

    <!-- Предложение вернуться к третьему шагу, а не вердикт «автозапуск не настроен» (TDD §5.3). -->
    <string name="onboarding_test_not_delivered">Если напоминание не придёт — вернитесь к шагу «Автозапуск без ограничений».</string>

    <!-- Обнаруженный отзыв ранее выданного разрешения (критерий приёмки 17). -->
    <string name="onboarding_revoked_notifications">Разрешение на уведомления отозвано в системных настройках. Пока его нет, напоминания не приходят.</string>
    <string name="onboarding_revoked_exact_alarms">Право на точные будильники отозвано. Напоминания будут приходить с опозданием.</string>
    <string name="onboarding_revoked_autostart">Подтверждение автозапуска снято.</string>

    <!-- Напоминания ненадёжны, пока цепочка не пройдена (НАП-18, НАП-21). -->
    <string name="onboarding_unreliable">Пока цепочка не пройдена, напоминания ненадёжны. Приёмы можно отмечать вручную — журнал работает целиком.</string>

    <!--
      Сводное состояние для строки настроек «Разрешения и автозапуск» (критерий приёмки 14).
      «Одно не выдано» — дословно из `design/screens/Settings.dc.html`; остальные формы
      через plurals (НФТ-44), потому что непройденных шагов бывает и два, и три.
    -->
    <string name="onboarding_summary_all_resolved">Всё настроено</string>

    <!-- Описания для чтения с экрана (НФТ-30): у значков карточек видимого текста нет. -->
    <string name="cd_onboarding_notifications">Уведомления</string>
    <string name="cd_onboarding_exact_alarms">Точные будильники</string>
    <string name="cd_onboarding_autostart">Автозапуск</string>
    <string name="cd_onboarding_granted">Разрешение выдано</string>
    <string name="cd_onboarding_hint">Косвенный признак</string>
    <string name="cd_onboarding_steps">Шаг %1$d из %2$d</string>
</resources>
