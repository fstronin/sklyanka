<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="setup_title">设置可靠性</string>
    <string name="setup_intro">在 EMUI 上，系统会积极清理后台应用。若不进行以下设置，服药提醒会延迟送达或完全收不到。</string>
    <string name="setup_intro_xiaomi">在 HyperOS 或 MIUI 上，系统会积极清理后台应用。若不进行以下设置，服药提醒会延迟送达或完全收不到。</string>
    <string name="setup_intro_samsung">在 One UI 上，系统会限制应用的后台活动。若不进行以下设置，服药提醒会延迟送达或完全收不到。</string>
    <string name="setup_intro_android">若不授予以下权限，服药提醒会延迟送达或完全收不到。</string>

    <string name="setup_step_notifications">通知</string>
    <string name="setup_step_notifications_caption">屏幕上的服药卡片</string>
    <string name="setup_issue_notifications">通知已关闭</string>
    <string name="setup_issue_channel">通知渠道已关闭</string>
    <string name="setup_issue_full_screen">未允许全屏通知</string>

    <string name="setup_step_exact_alarms">精确闹钟</string>
    <string name="setup_step_exact_alarms_caption">否则 Android 会把服药时间推迟到它方便的时间——最多半小时</string>
    <string name="setup_exact_alarms_indicator">手机将在状态栏把最近的提醒显示为闹钟。这是正常的：系统以此表示提醒已设置。</string>

    <string name="setup_step_app_startup">应用启动</string>
    <string name="setup_step_app_startup_caption">设置 → 电池 → 应用启动 → Sklyanka → 手动管理</string>
    <string name="setup_step_app_startup_action">开启“自启动”“关联启动”和“后台运行”</string>

    <string name="setup_step_autostart">自启动</string>
    <string name="setup_step_autostart_caption">设置 → 应用 → 权限 → 自启动 → Sklyanka</string>

    <string name="setup_step_battery_saving">省电</string>
    <string name="setup_step_battery_saving_caption_xiaomi">设置 → 应用 → Sklyanka → 省电 → 无限制</string>
    <string name="setup_step_battery_saving_caption_samsung">设置 → 设备维护 → 电池 → 后台使用限制 → 不应休眠的应用</string>

    <string name="setup_step_recents_pin">在最近任务中锁定</string>
    <string name="setup_step_recents_pin_caption">打开最近任务列表，将“Sklyanka”卡片下拉，然后点按出现的锁形图标</string>

    <string name="setup_unverifiable_app_startup">应用无法检查：自启动状态对它不可见。</string>
    <string name="setup_unverifiable_battery_saving">应用无法检查：省电状态对它不可见。</string>
    <string name="setup_unverifiable_recents_pin">应用无法检查：最近任务列表对它不可见。</string>

    <string name="setup_manual_confirm_app_startup">我已设置应用启动</string>
    <string name="setup_manual_confirm_autostart">我已设置自启动</string>
    <string name="setup_manual_confirm_battery_saving">我已取消省电限制</string>
    <string name="setup_manual_confirm_recents_pin">Sklyanka 已在最近任务中锁定</string>
    <string name="setup_manual_confirm_caption">根据您的说明记录：应用不检查此设置</string>

    <string name="setup_hint_battery">间接标志：已取消该应用的电池优化</string>

    <string name="setup_fallback_app_startup">此设备上的系统页面未能打开。请手动打开：设置 → 电池 → 应用启动 → Sklyanka → 手动管理。开启“自启动”“关联启动”和“后台运行”。</string>
    <string name="setup_fallback_battery_saving">此设备上的系统页面未能打开。请手动打开：设置 → 电池 → Sklyanka → 取消省电限制（“不限制”）。</string>
    <string name="setup_fallback_autostart">此设备上的系统页面未能打开。请手动打开：设置 → 应用 → 权限 → 自启动 → Sklyanka。开启“自启动”。在 MIUI 上为 安全 → 权限 → 自启动。</string>
    <string name="setup_fallback_battery_saving_xiaomi">此设备上的系统页面未能打开。请手动打开：设置 → 应用 → Sklyanka → 省电 → 无限制。如果没有“省电”项，请在“活动控制”中选择“无限制”。</string>
    <string name="setup_fallback_battery_saving_samsung">此设备上的系统页面未能打开。请手动打开：设置 → 设备维护 → 电池 → 后台使用限制 → 不应休眠的应用 → 将“Sklyanka”加入列表。</string>

