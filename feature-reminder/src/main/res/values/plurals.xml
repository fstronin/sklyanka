<?xml version="1.0" encoding="utf-8"?>
<!--
  Числительные полноэкранного напоминания (НФТ-44).

  Формы дозы дублируют формы экрана «Сегодня» намеренно: `feature-*` не зависят друг
  от друга, а общих форм пока нет в core-ui. Когда они там появятся, дублирование уйдёт
  одной правкой — до тех пор оно честнее зависимости между экранами.
-->
<resources>

    <!-- Доза одного приёма: «1 таблетка», «2 таблетки». -->
    <plurals name="reminder_dose_tablets">
        <item quantity="one">%1$s таблетка</item>
        <item quantity="few">%1$s таблетки</item>
        <item quantity="many">%1$s таблеток</item>
        <item quantity="other">%1$s таблетки</item>
    </plurals>
    <plurals name="reminder_dose_capsules">
        <item quantity="one">%1$s капсула</item>
        <item quantity="few">%1$s капсулы</item>
        <item quantity="many">%1$s капсул</item>
        <item quantity="other">%1$s капсулы</item>
    </plurals>
    <plurals name="reminder_dose_millilitres">
        <item quantity="one">%1$s мл</item>
        <item quantity="few">%1$s мл</item>
        <item quantity="many">%1$s мл</item>
        <item quantity="other">%1$s мл</item>
    </plurals>
    <plurals name="reminder_dose_drops">
        <item quantity="one">%1$s капля</item>
        <item quantity="few">%1$s капли</item>
        <item quantity="many">%1$s капель</item>
        <item quantity="other">%1$s капли</item>
    </plurals>
    <plurals name="reminder_dose_sprays">
        <item quantity="one">%1$s впрыск</item>
        <item quantity="few">%1$s впрыска</item>
        <item quantity="many">%1$s впрысков</item>
        <item quantity="other">%1$s впрыска</item>
    </plurals>
    <plurals name="reminder_dose_injections">
        <item quantity="one">%1$s инъекция</item>
        <item quantity="few">%1$s инъекции</item>
        <item quantity="many">%1$s инъекций</item>
        <item quantity="other">%1$s инъекции</item>
    </plurals>


    <!-- SKL-102: сводка за 7 дней. -->
    <plurals name="diagnostics_week_fired">
        <item quantity="one">сработало %1$d напоминание</item>
        <item quantity="few">сработало %1$d напоминания</item>
        <item quantity="many">сработало %1$d напоминаний</item>
        <item quantity="other">сработало %1$d напоминания</item>
    </plurals>
    <plurals name="diagnostics_week_missed">
        <item quantity="one">пропущено %1$d приём</item>
        <item quantity="few">пропущено %1$d приёма</item>
        <item quantity="many">пропущено %1$d приёмов</item>
        <item quantity="other">пропущено %1$d приёма</item>
    </plurals>
    <!-- SKL-106: исход служебной выгрузки журнала. -->
    <plurals name="diagnostics_journal_export_saved">
        <item quantity="one">Журнал выгружен: %1$d запись.</item>
        <item quantity="few">Журнал выгружен: %1$d записи.</item>
        <item quantity="many">Журнал выгружен: %1$d записей.</item>
        <item quantity="other">Журнал выгружен: %1$d записи.</item>
    </plurals>
</resources>
