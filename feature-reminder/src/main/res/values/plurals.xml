<?xml version="1.0" encoding="utf-8"?>
<!--
  Числительные полноэкранного напоминания (НФТ-44).

  Формы дозы дублируют формы экрана «Сегодня» намеренно: `feature-*` не зависят друг
  от друга, а общих форм пока нет в core-ui. Когда они там появятся, дублирование уйдёт
  одной правкой — до тех пор оно честнее зависимости между экранами.
-->
<resources>

    <!-- Доза одного приёма: «1 таблетка», «2 таблетки». -->
    <plurals name="reminder_dose_tablets">
        <item quantity="one">%1$s таблетка</item>
        <item quantity="few">%1$s таблетки</item>
        <item quantity="many">%1$s таблеток</item>
        <item quantity="other">%1$s таблетки</item>
    </plurals>
    <plurals name="reminder_dose_capsules">
        <item quantity="one">%1$s капсула</item>
        <item quantity="few">%1$s капсулы</item>
        <item quantity="many">%1$s капсул</item>
        <item quantity="other">%1$s капсулы</item>
    </plurals>
    <plurals name="reminder_dose_millilitres">
        <item quantity="one">%1$s мл</item>
        <item quantity="few">%1$s мл</item>
        <item quantity="many">%1$s мл</item>
        <item quantity="other">%1$s мл</item>
    </plurals>
    <plurals name="reminder_dose_doses">
        <item quantity="one">%1$s доза</item>
        <item quantity="few">%1$s дозы</item>
        <item quantity="many">%1$s доз</item>
        <item quantity="other">%1$s дозы</item>
    </plurals>

    <!-- Размер выгруженного журнала: «1 запись», «12 записей» (НФТ-44). -->
    <plurals name="diagnostics_export_records">
        <item quantity="one">%1$d запись</item>
        <item quantity="few">%1$d записи</item>
        <item quantity="many">%1$d записей</item>
        <item quantity="other">%1$d записи</item>
    </plurals>
</resources>
