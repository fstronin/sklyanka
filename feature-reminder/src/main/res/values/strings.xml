<?xml version="1.0" encoding="utf-8"?>
<!--
  Тексты полноэкранного напоминания и экрана диагностики.

  Формулировки карточки — дословно из макета `design/screens/Reminder.dc.html`.
  Русского текста в Kotlin-коде нет вообще (НФТ-42), числительные — через plurals (НФТ-44).

  Текстов экрана диагностики в макетах нет (ОВ-49): экран описан словами в НАП-37,
  и формулировки здесь — предложение задачи, а не срисованный макет.
-->
<resources>

    <!--
      ===== Полноэкранное напоминание (Reminder.dc.html) =====

      Плашки «Продублировано на часы» из макета здесь нет: интеграция с часами отложена
      до пост-MVP решением `ADR-0009`, и состояние о часах в первой версии не бывает
      истинным. Строка вернётся вместе с Wear Engine.
    -->

    <string name="reminder_overline">Приём по расписанию</string>
    <string name="reminder_time_pattern">HH:mm</string>

    <!-- Подпись кнопки откладывания собирается из настройки «Отложить на» (НАП-30). -->
    <string name="reminder_snooze">Отложить %1$d мин</string>

    <!-- Разделитель дозы и дозировки: «2 таблетки · 48 мг». -->
    <string name="reminder_dose_separator">" · "</string>

    <!-- «48 мг»: дозировка и её единица введены человеком и переводу не подлежат. -->
    <string name="reminder_strength">%1$s %2$s</string>
    <string name="strength_unit_milligram">мг</string>

    <!-- Отметка строки в карточке из нескольких приёмов (НАП-36). -->
    <string name="reminder_row_taken">Принято</string>
    <string name="reminder_row_skip">Пропустить</string>

    <!-- ===== Диагностика напоминаний (НАП-37) ===== -->

    <string name="diagnostics_title">Проверка напоминаний</string>

    <!-- Первый уровень: понятное и действенное (ОВ-49, SKL-79). -->
