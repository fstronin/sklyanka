<?xml version="1.0" encoding="utf-8"?>
<!--
  Тексты полноэкранного напоминания и экрана диагностики.

  Формулировки карточки — дословно из макета `design/screens/Reminder.dc.html`.
  Русского текста в Kotlin-коде нет вообще (НФТ-42), числительные — через plurals (НФТ-44).

  Текстов экрана диагностики в макетах нет (ОВ-49): экран описан словами в НАП-37,
  и формулировки здесь — предложение задачи, а не срисованный макет.
-->
<resources>

    <!--
      ===== Полноэкранное напоминание (Reminder.dc.html) =====

      Плашки «Продублировано на часы» из макета здесь нет: интеграция с часами отложена
      до пост-MVP решением `ADR-0009`, и состояние о часах в первой версии не бывает
      истинным. Строка вернётся вместе с Wear Engine.
    -->

    <string name="reminder_overline">Приём по расписанию</string>
    <string name="reminder_time_pattern">HH:mm</string>

    <!-- Подпись кнопки откладывания собирается из настройки «Отложить на» (НАП-30). -->
    <string name="reminder_snooze">Отложить %1$d мин</string>

    <!-- Разделитель дозы и дозировки: «2 таблетки · 48 мг». -->
    <string name="reminder_dose_separator">" · "</string>

    <!-- «48 мг»: дозировка и её единица введены человеком и переводу не подлежат. -->
    <string name="reminder_strength">%1$s %2$s</string>
    <string name="strength_unit_milligram">мг</string>

    <!-- Отметка строки в карточке из нескольких приёмов (НАП-36). -->
    <string name="reminder_row_taken">Принято</string>
    <string name="reminder_row_skip">Пропустить</string>

    <!-- ===== Диагностика напоминаний (НАП-37) ===== -->

    <string name="diagnostics_title">Проверка напоминаний</string>

    <!-- Первый уровень: понятное и действенное (ОВ-49, SKL-79). -->
    <string name="diagnostics_reliable">Всё в порядке</string>
    <string name="diagnostics_all_granted">Разрешения выданы</string>
    <string name="diagnostics_fix">Исправить</string>
    <string name="diagnostics_check_done">Проверка выполнена — напоминания поставлены</string>
    <string name="diagnostics_check_failed">Проверить не удалось: напоминания не перепланированы</string>
    <string name="diagnostics_support">Для поддержки</string>

    <!-- Сводка 7 дней фразой (ОВ-49). Формулировка ждёт дизайн, см. открытый вопрос. -->
    <string name="diagnostics_week_summary">За 7 дней: сработало %1$d, пропущено %2$d</string>
    <string name="diagnostics_week_summary_none">За 7 дней напоминаний не было</string>

    <!-- Последнее и следующее — простыми словами, без секунд и идентификаторов (ОВ-49). -->
    <string name="diagnostics_last_none">Напоминаний ещё не было</string>
    <string name="diagnostics_last_line">%1$s — %2$s</string>
    <string name="diagnostics_last_actual">показано в %1$s</string>
    <string name="diagnostics_on_time_word">вовремя</string>
    <string name="diagnostics_next_none">Следующего напоминания нет</string>
    <string name="diagnostics_next_line">%1$s — %2$s · %3$s</string>
    <string name="diagnostics_next_plan">план</string>

    <plurals name="diagnostics_late">
        <item quantity="one">с опозданием на %1$d минуту</item>
        <item quantity="few">с опозданием на %1$d минуты</item>
        <item quantity="many">с опозданием на %1$d минут</item>
        <item quantity="other">с опозданием на %1$d минуты</item>
    </plurals>

    <!-- Подавленное опоздавшее срабатывание: «сработало … — не показано» (ОВ-109, НАП-33). -->
    <string name="diagnostics_journal_too_late">сработало %1$s — не показано</string>

    <string name="diagnostics_section_last">Последнее напоминание</string>
    <string name="diagnostics_section_next">Следующее напоминание</string>
    <string name="diagnostics_section_reschedule">Последняя сборка плана</string>
    <string name="diagnostics_section_permissions">Разрешения</string>
    <string name="diagnostics_section_journal">Журнал срабатываний</string>
    <string name="diagnostics_section_on_time">Вовремя за 7 дней</string>

    <string name="diagnostics_none">нет данных</string>
    <string name="diagnostics_datetime_pattern">d MMMM, HH:mm:ss</string>

    <!-- «План 14:00 · факт 14:00:37 · отклонение 37 с». -->
    <string name="diagnostics_deviation">Отклонение %1$d с</string>
    <string name="diagnostics_planned">План %1$s</string>
    <string name="diagnostics_actual">Факт %1$s</string>
    <string name="diagnostics_scheduled_total">Всего поставлено будильников: %1$d</string>

    <string name="diagnostics_permission_notifications">Уведомления</string>
    <string name="diagnostics_permission_channel">Каналы уведомлений</string>
    <string name="diagnostics_permission_exact_alarms">Точные будильники</string>
    <string name="diagnostics_permission_full_screen">Полноэкранные уведомления</string>
    <string name="diagnostics_permission_dnd">Доступ к политике «Не беспокоить»</string>
    <string name="diagnostics_permission_boot">Приёмник загрузки</string>
    <string name="diagnostics_permission_autostart">Автозапуск и энергосбережение</string>

    <string name="diagnostics_state_granted">выдано</string>
    <string name="diagnostics_state_denied">не выдано</string>
    <string name="diagnostics_state_unknown">проверьте вручную</string>

    <!-- Пояснение к невыданному доступу к политике «Не беспокоить» (НАП-17). -->
    <string name="diagnostics_dnd_hint">В режиме «Не беспокоить» повторные напоминания будут беззвучными.</string>

    <!-- Предупреждение о ненадёжности напоминаний (НАП-18). -->
    <string name="diagnostics_warning_notifications">Напоминания сейчас не приходят: уведомления отключены. Приёмы можно отмечать вручную.</string>
    <string name="diagnostics_warning_channel">Напоминания сейчас не приходят: канал уведомлений отключён.</string>
    <string name="diagnostics_warning_exact_alarms">Напоминания могут приходить с опозданием: не выдано право на точные будильники.</string>
    <string name="diagnostics_warning_full_screen">Карточка приёма не появится на заблокированном экране: не выдано право на полноэкранные уведомления.</string>
    <string name="diagnostics_warning_both">Напоминания сейчас не приходят: отключены уведомления и не выдано право на точные будильники.</string>
    <!-- Системный раздел не открылся: тот же ручной путь, что на «Настроить надёжность» (ОВ-106). -->
    <string name="diagnostics_fallback_app_startup">Системный раздел на этом устройстве не открылся. Откройте его вручную: Настройки → Батарея → Запуск приложений → Склянка → Управлять вручную. Включите «Автозапуск», «Косвенный запуск» и «Работу в фоне».</string>

    <!-- Сообщение о перерыве в напоминаниях (НАП-38). -->
    <string name="diagnostics_outage">Напоминания не приходили с %1$s. Проверьте разрешения и автозапуск, затем нажмите «Проверить сейчас».</string>

    <!-- Сводка «вовремя за 7 дней» (НФТ-51): «12 из 13 · 92 %». Вовремя — по НАП-2. -->
    <string name="diagnostics_on_time">%1$d из %2$d · %3$d %%</string>
    <string name="diagnostics_on_time_none">Срабатываний за это время не было</string>
    <string name="diagnostics_on_time_rule">Вовремя — отклонение не больше 120 секунд</string>

    <string name="diagnostics_action_check">Проверить сейчас</string>
    <string name="diagnostics_action_export">Выгрузить журнал</string>
    <string name="diagnostics_action_setup">Пройти настройку заново</string>

    <!-- ===== Самопроверка доставки (SKL-86, ПМ-21, ОВ-108) ===== -->

    <!-- Точка входа и шторка запуска. -->
    <string name="diagnostics_action_check_delivery">Проверить доставку</string>
    <string name="diagnostics_check_sheet_title">Проверка доставки</string>
    <string name="diagnostics_check_sheet_text">Приложение поставит тестовое напоминание через 1–2 минуты. Сразу после начала закройте приложение — смахните его из списка недавних. Если приложение будет открыто, проверка не состоится. Блокировать телефон не нужно.</string>
    <string name="diagnostics_check_start">Начать проверку</string>
    <string name="diagnostics_check_sheet_cancel">Отмена</string>

    <!-- Ход проверки: плашка и тихая отмена. -->
    <string name="diagnostics_check_running">Проверка идёт: тестовое напоминание сработает примерно через минуту. Закройте приложение.</string>
    <string name="diagnostics_check_cancel">Отменить проверку</string>

    <!-- Исходы. Опоздание подставляется формами plurals/diagnostics_late (НФТ-44). -->
    <string name="diagnostics_check_on_time">Проверка доставки пройдена: тестовое напоминание пришло вовремя.</string>
    <string name="diagnostics_check_late">Проверка доставки: тестовое напоминание пришло %1$s. Телефон задержал его — проверьте настройки запуска и энергосбережения.</string>
    <string name="diagnostics_check_not_delivered">Проверка доставки не прошла: тестовое напоминание не пришло. Проверьте настройки запуска и энергосбережения.</string>
    <string name="diagnostics_check_not_completed">Проверка не состоялась: приложение было открыто. Закройте его и попробуйте снова.</string>
    <string name="diagnostics_check_repeat">Повторить проверку</string>
    <string name="diagnostics_check_acknowledge">Понятно</string>

