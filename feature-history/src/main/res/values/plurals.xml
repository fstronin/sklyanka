<?xml version="1.0" encoding="utf-8"?>
<!--
  Числительные экрана истории и документа отчёта (НФТ-44).

  Русский требует три формы — «1 пропуск», «2 пропуска», «5 пропусков», — и собрать их
  конкатенацией нельзя: получится «5 пропуск». Счётчик «принято N из M приёмов» берётся
  из общего `plurals` дизайн-системы: он один на продукт, и в отчёте врачу он обязан
  читаться так же, как на карточке лекарства.
-->
<resources>

    <!--
      Число принятых приёмов в сводке документа: «86 из 100 приёмов (86 %)».

      После «из» числительное требует родительного падежа, и для 2–4 он тоже
      множественный: «из 22 приёмов», а не «из 22 приёма». Поэтому формы `few`
      и `many` совпадают — это норма русского языка, а не ошибка.
    -->
    <plurals name="report_document_intakes_of_total">
        <item quantity="one">%1$d из %2$d приёма (%3$s)</item>
        <item quantity="few">%1$d из %2$d приёмов (%3$s)</item>
        <item quantity="many">%1$d из %2$d приёмов (%3$s)</item>
        <item quantity="other">%1$d из %2$d приёмов (%3$s)</item>
    </plurals>

    <!-- Строка пропусков по лекарству в документе отчёта (НФТ-44). -->
    <plurals name="report_document_missed_by_person">
        <item quantity="one">%1$d отмечен человеком</item>
        <item quantity="few">%1$d отмечены человеком</item>
        <item quantity="many">%1$d отмечены человеком</item>
        <item quantity="other">%1$d отмечены человеком</item>
    </plurals>

    <!--
      Доза одного приёма в документе отчёта: «1 таблетка», «2 таблетки».

      Формулировки те же, что в карточке лекарства: одна и та же доза не должна
      называться по-разному на экране и в отчёте, который человек отдаёт врачу.
      Количество приходит строкой, потому что доза бывает дробной («0,5»).
    -->
    <plurals name="report_document_dose_tablets">
        <item quantity="one">%1$s&#160;таблетка</item>
        <item quantity="few">%1$s&#160;таблетки</item>
        <item quantity="many">%1$s&#160;таблеток</item>
        <item quantity="other">%1$s&#160;таблетки</item>
    </plurals>
    <plurals name="report_document_dose_capsules">
        <item quantity="one">%1$s&#160;капсула</item>
        <item quantity="few">%1$s&#160;капсулы</item>
        <item quantity="many">%1$s&#160;капсул</item>
        <item quantity="other">%1$s&#160;капсулы</item>
    </plurals>
    <plurals name="report_document_dose_millilitres">
        <item quantity="one">%1$s&#160;мл</item>
        <item quantity="few">%1$s&#160;мл</item>
        <item quantity="many">%1$s&#160;мл</item>
        <item quantity="other">%1$s&#160;мл</item>
    </plurals>
    <plurals name="report_document_dose_drops">
        <item quantity="one">%1$s&#160;капля</item>
        <item quantity="few">%1$s&#160;капли</item>
        <item quantity="many">%1$s&#160;капель</item>
        <item quantity="other">%1$s&#160;капли</item>
    </plurals>
    <plurals name="report_document_dose_sprays">
        <item quantity="one">%1$s&#160;впрыск</item>
        <item quantity="few">%1$s&#160;впрыска</item>
        <item quantity="many">%1$s&#160;впрысков</item>
        <item quantity="other">%1$s&#160;впрыска</item>
    </plurals>
    <plurals name="report_document_dose_injections">
        <item quantity="one">%1$s&#160;инъекция</item>
        <item quantity="few">%1$s&#160;инъекции</item>
        <item quantity="many">%1$s&#160;инъекций</item>
        <item quantity="other">%1$s&#160;инъекции</item>
    </plurals>

    <!-- Подпись плитки «дней без пропусков» для чтения с экрана. -->
    <plurals name="cd_history_days_without_misses">
        <item quantity="one">%1$d день без пропусков</item>
        <item quantity="few">%1$d дня без пропусков</item>
        <item quantity="many">%1$d дней без пропусков</item>
        <item quantity="other">%1$d дня без пропусков</item>
    </plurals>

    <plurals name="cd_history_on_time">
        <item quantity="one">принято вовремя, %1$d из %2$d приёма</item>
        <item quantity="few">принято вовремя, %1$d из %2$d приёмов</item>
        <item quantity="many">принято вовремя, %1$d из %2$d приёмов</item>
        <item quantity="other">принято вовремя, %1$d из %2$d приёма</item>
    </plurals>

    <!-- Подпись плитки «пропусков за месяц» для чтения с экрана. -->
    <plurals name="cd_history_misses">
        <item quantity="one">%1$d пропуск за месяц</item>
        <item quantity="few">%1$d пропуска за месяц</item>
        <item quantity="many">%1$d пропусков за месяц</item>
        <item quantity="other">%1$d пропуска за месяц</item>
    </plurals>
</resources>
