<?xml version="1.0" encoding="utf-8"?>
<!--
  Числительные экрана истории и документа отчёта (НФТ-44).

  Русский требует три формы — «1 пропуск», «2 пропуска», «5 пропусков», — и собрать их
  конкатенацией нельзя: получится «5 пропуск». Счётчик «принято N из M приёмов» берётся
  из общего `plurals` дизайн-системы: он один на продукт, и в отчёте врачу он обязан
  читаться так же, как на карточке лекарства.
-->
<resources>

    <!-- Строка пропусков по лекарству в документе отчёта. -->
    <plurals name="report_document_medication_misses">
        <item quantity="one">%1$d пропуск (отмечено человеком: %2$d, без отметки: %3$d)</item>
        <item quantity="few">%1$d пропуска (отмечено человеком: %2$d, без отметки: %3$d)</item>
        <item quantity="many">%1$d пропусков (отмечено человеком: %2$d, без отметки: %3$d)</item>
        <item quantity="other">%1$d пропуска (отмечено человеком: %2$d, без отметки: %3$d)</item>
    </plurals>

    <!--
      Доза одного приёма в документе отчёта: «Доза: по 1 таблетке», «по 2 таблетки».

      Формулировки те же, что в карточке лекарства: одна и та же доза не должна
      называться по-разному на экране и в отчёте, который человек отдаёт врачу.
      Количество приходит строкой, потому что доза бывает дробной («0,5»).
    -->
    <plurals name="report_document_dose_tablets">
        <item quantity="one">Доза: по %1$s таблетке</item>
        <item quantity="few">Доза: по %1$s таблетки</item>
        <item quantity="many">Доза: по %1$s таблеток</item>
        <item quantity="other">Доза: по %1$s таблетки</item>
    </plurals>
    <plurals name="report_document_dose_capsules">
        <item quantity="one">Доза: по %1$s капсуле</item>
        <item quantity="few">Доза: по %1$s капсулы</item>
        <item quantity="many">Доза: по %1$s капсул</item>
        <item quantity="other">Доза: по %1$s капсулы</item>
    </plurals>
    <plurals name="report_document_dose_millilitres">
        <item quantity="one">Доза: по %1$s мл</item>
        <item quantity="few">Доза: по %1$s мл</item>
        <item quantity="many">Доза: по %1$s мл</item>
        <item quantity="other">Доза: по %1$s мл</item>
    </plurals>
    <plurals name="report_document_dose_doses">
        <item quantity="one">Доза: по %1$s дозе</item>
        <item quantity="few">Доза: по %1$s дозы</item>
        <item quantity="many">Доза: по %1$s доз</item>
        <item quantity="other">Доза: по %1$s дозы</item>
    </plurals>

    <!-- Подпись плитки «дней без пропусков» для чтения с экрана. -->
    <plurals name="cd_history_days_without_misses">
        <item quantity="one">%1$d день без пропусков</item>
        <item quantity="few">%1$d дня без пропусков</item>
        <item quantity="many">%1$d дней без пропусков</item>
        <item quantity="other">%1$d дня без пропусков</item>
    </plurals>

    <!-- Подпись плитки «пропусков за месяц» для чтения с экрана. -->
    <plurals name="cd_history_misses">
        <item quantity="one">%1$d пропуск за месяц</item>
        <item quantity="few">%1$d пропуска за месяц</item>
        <item quantity="many">%1$d пропусков за месяц</item>
        <item quantity="other">%1$d пропуска за месяц</item>
    </plurals>
</resources>
