<?xml version="1.0" encoding="utf-8"?>
<!--
  Манифест сетевого контура аналитики (SKL-165, Р-93 п. 2, ADR-0017).

  `INTERNET` объявляется здесь: это второй (и в поставляемой сборке — единственный) источник
  сетевого разрешения. Гейт `verifyManifest<Вариант>` держит правило «разрешение контура
  законно, только если его объявил контур, входящий в артефакт, и ни один модуль вне
  контуров его не объявляет»; `pro` объявляет ту же сеть ещё и платёжным контуром, и это
  законный случай, а не дубль.

  Разрешения состояния сети (`ACCESS_NETWORK_STATE`, `ACCESS_WIFI_STATE`) не объявляются
  никогда (ПЛ-3, НФТ-15). Поставщик их рекомендует, а его SDK объявляет
  `ACCESS_NETWORK_STATE` и `AD_ID` в собственном манифесте — оба снимаются манифестом
  `app` через `tools:node="remove"`, и проверка слитого манифеста валит сборку, если они
  вернутся. Рекламные идентификаторы не собираются ни при каких условиях (ПМ-26), поэтому
  модули `ads-identifier` (GAID/OAID) не подключаются вовсе.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Состояние сети нужно самому SDK, а не продукту: перед отправкой событий он зовёт
      `ConnectivityManager.getActiveNetworkInfo()`, и без разрешения вызов падает, а SDK
      молча считает сеть недоступной — события не уходят (измерено на устройстве, Р-100).
      Разрешение не даёт доступа к данным, только к признаку «сеть есть». Оно объявлено
      здесь, а не взято из манифеста SDK, чтобы граница контура оставалась нашей.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
