<?xml version="1.0" encoding="utf-8"?>
<!--
  Манифест платного сетевого контура (SKL-122, ADR-0010 п. 1).

  `INTERNET` объявляется здесь и только здесь: это единственное место сборки, которому
  сеть разрешена, и гейт `verifyManifest<Вариант>` держит ровно это правило — разрешение
  в слитом манифесте законно, только если объявлено манифестом контура и ни одним другим
  модулем. Сеть нужна двум точкам продукта: проверке подписки и покупке в магазине.

  Разрешения состояния сети (`ACCESS_NETWORK_STATE`, `ACCESS_WIFI_STATE`) остаются
  запрещёнными всегда (ПЛ-3, НФТ-15): их снимает манифест `app` через `tools:node="remove"`,
  в том числе когда их приносит замыкание вендорского клиента.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
