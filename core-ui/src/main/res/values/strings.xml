<?xml version="1.0" encoding="utf-8"?>
<!--
  Общие строки интерфейса. Все тексты живут здесь, а не в Kotlin (НФТ-42).

  Раздел «Подписи компонентов» — то, что компонент показывает сам и о чём экран
  не должен помнить. Раздел «Заглушки превью» — тексты каталога и превью: они тоже
  ресурсы, иначе русский текст просочится в код именно там, где его никто не ищет.
  Правдоподобных названий лекарств и имён людей среди заглушек нет намеренно:
  снимок экрана разработчика не должен превращаться в медицинские данные (НФТ-19).
-->
<resources>
    <string name="app_name">Склянка</string>

    <!--
      Фирменная подпись под названием. Хранится строчными и переводится в прописные
      отрисовкой: читалка должна произносить слова, а не буквы.
    -->
    <string name="brand_tagline">приём лекарств</string>

    <!-- Издатель у нижнего края заставки. -->
    <string name="brand_vendor">Stohastika</string>

    <!-- Подписи компонентов -->
    <string name="action_taken">Принято</string>
    <string name="action_skip">Пропустить</string>
    <string name="action_take">Принять</string>
    <string name="action_back">Назад</string>
    <string name="action_cancel">Отмена</string>
    <string name="action_done">Готово</string>
    <string name="status_missed">Пропущено</string>
    <string name="status_marked_by_you">отметили вы</string>
    <string name="label_as_needed">По потребности</string>
    <string name="profile_label">Профиль · %1$s</string>

    <!--
      Подписи вкладок нижней панели (§4.13, ОВ-91). Панель — компонент дизайн-системы,
      и подписи живут рядом с другими подписями компонентов: экранный модуль не держит
      своей копии панели и, значит, своей копии подписей.
    -->
    <string name="tab_today">Сегодня</string>
    <string name="tab_meds">Лекарства</string>
    <string name="tab_settings">Настройки</string>

    <!--
      Баннер чужого профиля (ПРФ-13). Текст дословно из design/screens/MainProfile.dc.html,
      а не короткая форма текстовой спецификации («Это не ваши приёмы»): вторая фраза
      называет последствие, и человек узнаёт не только, что он не там, но и что случится,
      если он нажмёт кнопку.
    -->
    <string name="profile_banner">Это не ваши приёмы. Отметки сохранятся в профиль «%1$s».</string>

    <!--
      Инициал в кружке аватара профиля владельца (design/screens/Main.dc.html,
      design/screens/Settings.dc.html). Константа, а не первая буква имени: своему профилю
      индикации не добавляется (ПРФ-16), а переименование своего профиля — открытый
      вопрос ПРФ-27.
    -->
    <string name="profile_self_initial">Я</string>

    <!-- Описания для чтения с экрана (НФТ-30); формулировки — из aria-label макетов -->
    <string name="cd_mark_intake">Отметить приём %1$s</string>
    <string name="cd_back">Назад</string>
    <string name="cd_app_mark">Знак Склянка</string>
    <string name="cd_app_mark_glass">Знак Склянка: донце толстого стекла</string>
    <string name="cd_icon_on_dark">Иконка на тёмном фоне</string>
    <string name="cd_icon_on_light">Иконка на светлом фоне</string>
    <string name="cd_flat_mark_72">Плоская редукция 72 пикселя</string>
    <string name="cd_flat_mark_44">Плоская редукция 44 пикселя</string>
    <string name="cd_flat_mark_28">Плоская редукция 28 пикселей</string>
    <string name="cd_flat_mark_18">Плоская редукция 18 пикселей</string>
    <string name="cd_warning">Предупреждение</string>
    <string name="cd_profile">Чужой профиль</string>
    <!-- Аватар в шапке ведёт в список профилей настроек (ПРФ-19, решение по ОВ-54). -->
    <string name="cd_profile_avatar">Профили</string>

    <!-- Переключатель циферблат/клавиатура в диалоге времени (SKL-69, §4.14). -->
    <string name="cd_switch_time_input">Клавиатурный ввод времени</string>

    <!-- Выбранный вариант диалога выбора из списка: смысл не одним цветом (SKL-78, НФТ-30). -->
    <string name="cd_list_picker_selected">Выбрано</string>

    <!--
      Легенда недельной полосы приёмов (блок «Последние 7 дней», SKL-10).

      Отдельные строки, а не переиспользованные «Принято» кнопки отметки и «Пропущено»
      статуса: легенда объясняет вид кружка, а не называет действие, и при правке подписи
      кнопки она обязана остаться прежней.
    -->
    <string name="adherence_legend_taken">Принято</string>
    <string name="adherence_legend_missed">Пропущено</string>
    <string name="adherence_legend_today">Сегодня</string>

    <!-- Числа с единицами — через plurals, а не конкатенацией (НФТ-44) -->
    <plurals name="intakes_taken_of_total">
        <item quantity="one">Принято %1$d из %2$d приёма</item>
        <item quantity="few">Принято %1$d из %2$d приёмов</item>
        <item quantity="many">Принято %1$d из %2$d приёмов</item>
        <item quantity="other">Принято %1$d из %2$d приёма</item>
    </plurals>
    <plurals name="pills_left">
        <item quantity="one">осталась %1$d таблетка</item>
        <item quantity="few">осталось %1$d таблетки</item>
        <item quantity="many">осталось %1$d таблеток</item>
        <item quantity="other">осталось %1$d таблетки</item>
    </plurals>

    <!-- Заглушки превью и каталога компонентов -->
    <string name="preview_date">Пятница, 25 сентября</string>
    <string name="preview_screen_title">Сегодня</string>
