    <!--
      Доза приёма и дозировка препарата (§5.11). Формат живёт в дизайн-системе, а не на
      экране «Сегодня»: ту же подпись несёт строка приёма в Glance-виджете, и вторая
      редакция разошлась бы с первой (см. `DoseText`).
    -->
    <plurals name="dose_tablets">
        <item quantity="one">%1$s&#160;таблетка</item>
        <item quantity="few">%1$s&#160;таблетки</item>
        <item quantity="many">%1$s&#160;таблеток</item>
        <item quantity="other">%1$s&#160;таблетки</item>
