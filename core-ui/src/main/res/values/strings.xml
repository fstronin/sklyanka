    <string name="preview_field_unit">мг</string>
    <string name="preview_field_error">Заполните поле</string>
    <string name="preview_chip_label">Таблетка</string>
    <string name="preview_switch_label">Настойчивое напоминание</string>
    <string name="preview_switch_caption">Повторить, если не отметили</string>
    <string name="preview_banner_warning">Упаковка заканчивается, пора пополнить</string>
    <string name="preview_banner_profile">Это не ваши приёмы. Отметки сохранятся в чужой профиль.</string>
    <string name="preview_banner_neutral">Пояснение к разделу настроек</string>
    <string name="preview_empty_title">Пока ничего не запланировано</string>
    <string name="preview_empty_text">Добавьте лекарство — и его приёмы появятся здесь по часам.</string>

    <!-- Разделы каталога компонентов (только отладочная сборка) -->
    <string name="catalog_title">Каталог компонентов</string>
    <string name="catalog_typography">Типографика</string>
    <string name="catalog_intake_card">Карточка приёма</string>
