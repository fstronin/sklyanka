<?xml version="1.0" encoding="utf-8"?>
<!--
  Ярлык запуска на диагностику напоминаний (НАП-37).

  Постоянная точка входа — пункт настроек «Разрешения и автозапуск» (SKL-20), и решение,
  один это экран с онбордингом или два разных, не принято (ОВ-48). До тех пор экран
  достижим ярлыком: диагностика, до которой нельзя добраться, не отвечает ни на один
  вопрос человека, у которого не приходят напоминания.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Экран разрешений и автозапуска (SKL-14, НАП-21). Стоит первым: до того, как цепочка
      пройдена, диагностике нечего показывать, кроме невыданных разрешений.
    -->
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_notification_mark"
        android:shortcutId="permissions_onboarding"
        android:shortcutLongLabel="@string/permissions_shortcut_long_label"
        android:shortcutShortLabel="@string/permissions_shortcut_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="ru.heuri.sklyanka.feature.onboarding.PermissionsActivity"
            android:targetPackage="ru.heuri.sklyanka" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_notification_mark"
        android:shortcutId="reminders_diagnostics"
        android:shortcutLongLabel="@string/diagnostics_shortcut_long_label"
        android:shortcutShortLabel="@string/diagnostics_shortcut_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="ru.heuri.sklyanka.feature.reminder.DiagnosticsActivity"
            android:targetPackage="ru.heuri.sklyanka" />
    </shortcut>
</shortcuts>
