<?xml version="1.0" encoding="utf-8"?>
<!--
  Ярлыки быстрого доступа по долгому нажатию на иконку (SKL-80, ОВ-96).

  Ярлык ровно один — «Добавить лекарство», самое частое действие человека, заводящего
  курс. Служебные точки входа («Разрешения и автозапуск», диагностика) из ярлыков убраны:
  они достижимы строками настроек (ОВ-48/ОВ-49), а быстрый доступ — для частых действий.

  Деструктивных и необратимых пунктов здесь нет и не будет. Системный пункт «Удалить
  приложение» меню лаунчера приложению не принадлежит, и признак перехода («стрелка»)
  в списке рисует лаунчер — статический ярлык их не задаёт (ОВ-96).
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_notification_mark"
        android:shortcutId="add_medication"
        android:shortcutLongLabel="@string/add_medication_shortcut_long_label"
        android:shortcutShortLabel="@string/add_medication_shortcut_label">
        <intent
            android:action="ru.stohastika.sklyanka.action.ADD_MEDICATION"
            android:targetClass="ru.stohastika.sklyanka.MainActivity"
            android:targetPackage="ru.stohastika.sklyanka" />
    </shortcut>
</shortcuts>
