<?xml version="1.0" encoding="utf-8"?>
<!--
  Что приложение отдаёт наружу через FileProvider (SKL-33, НФТ-17).

  Ровно один каталог — приватный кеш отчётов врачу. Весь кеш не открывается: чем уже
  область, тем меньше шансов отдать получателю то, чего он не должен видеть. Файл
  ложится сюда перед системным обменом и перезаписывается при следующей передаче;
  доступ выдаётся только на чтение и только к этому файлу.
-->
<paths>
    <cache-path
        name="reports"
        path="reports/" />
</paths>
