<?xml version="1.0" encoding="utf-8"?>
<!-- Строки приложения. Русского текста в Kotlin-коде нет вообще (НФТ-42). -->
<resources>
    <string name="app_name">Склянка</string>

    <!--
      Имя профиля владельца по умолчанию. Профиль создаётся при первом запуске, до всякого
      онбординга (ПРФ-25), поэтому имя берётся отсюда, а не придумывается слоем данных.
    -->
    <string name="profile_self_default_name">Я</string>
    <!-- ===== Напоминания (SKL-13) ===== -->

    <!--
      Названия каналов уведомлений (НАП-24). Человек видит их в системных настройках
      приложения, поэтому они обязаны объяснять, что именно они шлют.
    -->
    <string name="reminder_channel_regular_name">Напоминания о приёме</string>
    <string name="reminder_channel_regular_description">Карточка приёма в назначенное время</string>
    <string name="reminder_channel_persistent_name">Настойчивые напоминания</string>
    <string name="reminder_channel_persistent_description">Повтор, если приём остался неотмеченным</string>

    <!-- Надзаголовок уведомления и разделитель списка лекарств в нём. -->
    <string name="reminder_overline">Приём по расписанию</string>
    <string name="reminder_time_pattern">HH:mm</string>
    <string name="reminder_notification_separator">" · "</string>

    <!-- «14:00 · Приём по расписанию» — вторая строка уведомления. -->
    <string name="reminder_notification_text">%1$s · %2$s</string>

    <!--
      Ярлык быстрого доступа «Добавить лекарство» (SKL-80, ОВ-96): короткая подпись —
      то, что видно в списке, длинная — запас для лаунчера. Обе локализуются (НФТ-43).
    -->
    <string name="add_medication_shortcut_label">Добавить лекарство</string>
    <string name="add_medication_shortcut_long_label">Новое лекарство</string>

    <!--
      Подпись окна диагностики напоминаний в недавних (НАП-37). Ярлыка диагностики больше
      нет (SKL-80): экран достижим строкой настроек, а подпись несёт `android:label`
      у `DiagnosticsActivity`. SKL-79 переименовывает экран — значение приводится там.
    -->
    <string name="diagnostics_shortcut_label">Напоминания</string>

    <!-- ===== Онбординг разрешений (SKL-14) ===== -->

    <!--
      Подпись окна экрана разрешений.

      Вход — строка настроек «Разрешения и автозапуск» (SKL-20, ОВ-48). Название строки —
      дословно из макета `design/screens/Settings.dc.html`, чтобы при переезде в настройки
      его не пришлось менять; ярлык запуска убран (SKL-80).
    -->
    <string name="permissions_shortcut_label">Разрешения и автозапуск</string>
</resources>
