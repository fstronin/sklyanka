<?xml version="1.0" encoding="utf-8"?>
<!-- Строки приложения. Русского текста в Kotlin-коде нет вообще (НФТ-42). -->
<resources>
    <string name="app_name">Склянка</string>

    <!--
      Диалог первого запуска (Р-89, правило AppGallery 7.5). Текст говорит только правду
      о продукте: данные лежат на устройстве, сети в сборке нет. Кнопка одна — принятие;
      ссылка открывает ту же политику, что и строка настроек.
    -->
    <string name="privacy_consent_title">Политика конфиденциальности</string>
    <string name="privacy_consent_message">«Склянка» хранит все данные только на этом устройстве и никуда их не передаёт. Прочитайте политику конфиденциальности перед началом работы. Без принятия политики приложение не запускается.</string>
    <string name="privacy_consent_open_policy">Открыть политику конфиденциальности</string>
    <string name="privacy_consent_agree">Принимаю</string>
    <string name="privacy_consent_decline">Отказываюсь</string>

    <!--
      Имя профиля владельца по умолчанию. Профиль создаётся при первом запуске, до всякого
      онбординга (ПРФ-25), поэтому имя берётся отсюда, а не придумывается слоем данных.
    -->
    <string name="profile_self_default_name">Я</string>
    <!-- ===== Напоминания (SKL-13) ===== -->

    <!--
      Названия каналов уведомлений (НАП-24). Человек видит их в системных настройках
      приложения, поэтому они обязаны объяснять, что именно они шлют.
    -->
    <string name="reminder_channel_regular_name">Напоминания о приёме</string>
    <string name="reminder_channel_regular_description">Карточка приёма в назначенное время</string>
    <string name="reminder_channel_persistent_name">Настойчивые напоминания</string>
    <string name="reminder_channel_persistent_description">Повтор, если приём остался неотмеченным</string>

    <!-- Надзаголовок уведомления и разделитель списка лекарств в нём. -->
    <string name="reminder_overline">Приём по расписанию</string>
    <string name="reminder_time_pattern">HH:mm</string>
    <string name="reminder_notification_separator">" · "</string>

    <!-- «14:00 · Приём по расписанию» — вторая строка уведомления. -->
    <string name="reminder_notification_text">%1$s · %2$s</string>

    <!--
      Ярлык быстрого доступа «Добавить лекарство» (SKL-80, ОВ-96): короткая подпись —
      то, что видно в списке, длинная — запас для лаунчера. Обе локализуются (НФТ-43).
    -->
    <string name="add_medication_shortcut_label">Добавить лекарство</string>
    <string name="add_medication_shortcut_long_label">Новое лекарство</string>

    <!--
      Подпись окна диагностики напоминаний в недавних (НАП-37). Ярлыка диагностики больше
      нет (SKL-80): экран достижим строкой настроек, а подпись несёт `android:label`
      у `DiagnosticsActivity`. SKL-79 переименовывает экран — значение приводится там.
    -->
    <string name="diagnostics_shortcut_label">Напоминания</string>

    <!-- ===== Онбординг разрешений (SKL-14) ===== -->

    <!--
      Подпись окна экрана разрешений.

      Вход — строка настроек «Разрешения и автозапуск» (SKL-20, ОВ-48). Название строки —
      дословно из макета `design/screens/Settings.dc.html`, чтобы при переезде в настройки
      его не пришлось менять; ярлык запуска убран (SKL-80).
    -->
    <string name="permissions_shortcut_label">Разрешения и автозапуск</string>

    <!--
      База на устройстве новее установленной сборки (Р-44, ADR-0012 п. 7). Блокирующий экран
      не даёт продолжить и не обещает обновление само — говорим только то, что верно:
      данные целы, лечится установкой новой версии из магазина.
    -->
    <string name="database_too_new_title">База новее, обновите приложение</string>
    <string name="database_too_new_explanation">Данные на телефоне созданы более новой версией приложения. Эта версия их не знает и менять не будет.</string>
    <string name="database_too_new_data_kept">История приёмов цела. Установите новую версию из магазина — приложение откроется как прежде.</string>
    <string name="database_too_new_notification_title">Обновите приложение</string>
    <string name="database_too_new_notification_text">Напоминания не сработают, пока вы не обновите приложение.</string>
    <!-- База старее сборки, а места на копию перед обновлением схемы нет (ADR-0012 п. 3):
         обновление не выполняется, данные не меняются, человеку называется число. -->
    <string name="database_no_space_title">Не хватает места для обновления</string>
    <string name="database_no_space_missing">Нужно освободить ещё %1$d МБ.</string>
    <string name="database_no_space_explanation">Чтобы обновить базу без потери данных, приложению нужно сохранить её копию. Пока места нет, обновление не выполняется.</string>
    <string name="database_no_space_data_kept">История приёмов цела. Освободите место и откройте приложение снова.</string>
    <string name="database_no_space_notification_title">Не хватает места</string>
    <string name="database_no_space_notification_text">Напоминания не сработают, пока вы не освободите место.</string>
</resources>
