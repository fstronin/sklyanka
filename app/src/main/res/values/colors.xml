<?xml version="1.0" encoding="utf-8"?>
<!--
  Цвета, которые нужны платформе в разметке: вектора знака и плитки иконки.

  Цвета профиля здесь больше нет. Значение `profile_self_default` жило тут по замечанию
  SKL-04 с пометкой «переедет в палитру при SKL-15» — переехало: цвет профиля владельца
  задаёт ProfilePalette.ownerAccentArgb в core-ui, и токен цвета живёт в одном месте
  (НФТ-47). Два места расходятся на первой же правке, и расходятся молча, потому что
  цвет своего профиля нигде не показывается как индикация (ПРФ-16).
-->
<resources>
    <!--
      Цвета фирменного знака (SKL-21).

      Ресурсы, а не литералы в разметке: значения токенов дизайн-системы живут в одном
      месте, и векторные слои знака ссылаются на них так же, как код ссылается на
      SklyankaColors (НФТ-47). Значения с прозрачностью записаны в #AARRGGBB — иначе
      остановку градиента не задать: android:fillAlpha к отдельному <item> не относится.

      Источник — docs/spec/08-design-system.md §5, §7 и макеты SklyankaMark.dc.html
      и SklyankaIcon.dc.html.
    -->

    <!-- Плитки иконки: светлая по умолчанию, тёмная — в `-night` (ОВ-95, §7). -->
    <color name="mark_tile_dark">#191512</color>
    <color name="mark_tile_light">#EFE7DB</color>

    <!-- Краски знака: светлая на тёмной плитке, тёмная на светлой, белый блик серпа. -->
    <color name="mark_ink_on_dark">#FBF7F1</color>
    <color name="mark_ink_on_light">#241F1B</color>
    <color name="mark_highlight">#FFFFFF</color>

    <!-- Акцент тёмной среды: тёплая дуга преломлённого луча и каустика (§5). -->
    <color name="mark_accent">#C9633D</color>

    <!-- Силуэт: монохромный слой иконки и значок уведомления. Систему он не красит. -->
    <color name="mark_silhouette">#FFFFFF</color>

    <!-- Тело знака: радиальный градиент 0,24 → 0,07 → 0,015 на тёмном. -->
    <color name="mark_body_dark_0">#3DFBF7F1</color>
    <color name="mark_body_dark_1">#12FBF7F1</color>
    <color name="mark_body_dark_2">#04FBF7F1</color>

    <!-- Он же на светлом: белый блик гаснет в тёмную тень. -->
    <color name="mark_body_light_0">#F2FFFFFF</color>
    <color name="mark_body_light_1">#59FFFFFF</color>
    <color name="mark_body_light_2">#0F241F1B</color>

    <!-- Ободок: линейный градиент 0,85 → 0,16 → 0,42 на тёмном. -->
    <color name="mark_rim_dark_0">#D9FBF7F1</color>
    <color name="mark_rim_dark_1">#29FBF7F1</color>
    <color name="mark_rim_dark_2">#6BFBF7F1</color>

    <!-- Он же на светлом: 0,16 → 0,5 → 0,22 тёмной краской. -->
    <color name="mark_rim_light_0">#29241F1B</color>
    <color name="mark_rim_light_1">#80241F1B</color>
    <color name="mark_rim_light_2">#38241F1B</color>

    <!-- Каустика: акцент 0,62 (на тёмном) и 0,55 (на светлом), гаснущий в ноль. -->
    <color name="mark_caustic_dark">#9EC9633D</color>
    <color name="mark_caustic_light">#8CC9633D</color>
    <color name="mark_caustic_clear">#00C9633D</color>
</resources>
