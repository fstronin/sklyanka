<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Тема-обёртка до появления дизайн-системы (SKL-05).

      Принудительное затемнение системы к приложению **не применяется** (§9, SKL-120):
      цвета назначены токенами, и системная инверсия нарисовала бы поверх наших ролей
      вторую тему — сводя на нет и палитру Р-20, и акцентную тему «Про». Тот же атрибут
      повторён в `values-night/themes.xml`: тёмная среда — не повод включать инверсию,
      у неё свои роли.
    -->
    <style name="Theme.Sklyanka" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!--
      Заставка (SKL-21).

      Это не экран и не Activity, а первый кадр запуска: полотно и знак рисует сама
      система, до того как приложение успевает что-либо построить. Отсюда требование
      НФТ-21 выполняется не оптимизацией, а устройством — заставке нечего успевать.

      `Theme.SplashScreen` из androidx.core:core-splashscreen даёт один и тот же
      механизм и на Android 12+, где он штатный, и ниже, где его нет: minSdk у нас 26
      (ПЛ-1), и собственный экран-заставка для старых версий означал бы вторую
      реализацию с собственными ошибками.

      `postSplashScreenTheme` — тема, в которую окно переключается, когда заставка
      уходит. Без неё приложение осталось бы жить в теме заставки.
    -->
    <style name="Theme.Sklyanka.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mark_tile_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Sklyanka</item>
        <!--
          Заставку рисует система до запуска Activity, поэтому edge-to-edge на неё
          не влияет: тёмный статус-бар и светлые значки задаются темой (SKL-72 §4.1).
          Полотно заставки и знак и так тёмное и светлое соответственно.
        -->
        <item name="android:statusBarColor">@color/mark_tile_dark</item>
        <item name="android:navigationBarColor">@color/mark_tile_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Светлые значки навигационной панели — API 27; до него атрибут просто игнорируется. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
