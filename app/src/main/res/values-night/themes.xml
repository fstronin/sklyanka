<?xml version="1.0" encoding="utf-8"?>
<!--
  Тёмная среда интерфейса на уровне окна (§9, Р-23, SKL-120).

  Это не вторая тема оформления, а тот же кадр окна в тёмных ролях: `windowBackground`
  до первой отрисовки Compose и значки системных панелей. Без этого файла система,
  переключённая в тёмную тему, показала бы светлый фон окна между снятием заставки
  и первым кадром приложения — ту самую вспышку, ради которой заставка и заведена.

  Квалификатор `-night` — это и есть следование за системной настройкой (Р-23): своего
  переключателя у среды нет, и второй механизм её выбора не заводится.

  Принудительное затемнение выключено и здесь: у тёмной среды свои роли (§9), и системная
  инверсия поверх них была бы второй темой, а не первой.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Sklyanka" parent="android:Theme.Material.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowBackground">@color/environment_dark_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Тёмный фон — светлые значки системных панелей (SKL-72 §4). -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!--
      Заставка в тёмной среде — та же холодная плитка: её полотно задано решением, а не
      средой (§9), и `-night` его не трогает. Стиль объявлен здесь целиком, потому что
      ресурс стиля переопределяется как целое, а не по атрибутам.
    -->
    <style name="Theme.Sklyanka.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mark_tile_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Sklyanka</item>
        <item name="android:statusBarColor">@color/mark_tile_dark</item>
        <item name="android:navigationBarColor">@color/mark_tile_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
