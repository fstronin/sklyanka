<?xml version="1.0" encoding="utf-8"?>
<!--
  Передний план адаптивной иконки тёплого варианта («Про», §2.4, SKL-120), светлая
  системная тема: тёмный знак на тёплой бумажной подложке.

  Геометрия и слои — те же, что у холодного варианта (копия `ic_launcher_foreground.xml`
  с тёплыми красками): у обоих вариантов одни и те же слои и альфы, разные у них краски
  и плитка. Копия, а не общий ресурс, потому что вектор читает цвета из `@color/*`,
  а выбора палитры у вектора нет.

  Геометрия — поле 200×200 из `design/screens/SklyankaMark.dc.html`, то же самое,
  из которого рисуется компонент знака в core-ui. Группа `<group>` переносит поле 200
  в поле этого ресурса: правится масштаб, а не полсотни координат.

  Цвета — из `values/colors.xml`; литералов цвета в разметке нет (НФТ-47).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <!-- Поле знака 200×200 внутри поля ресурса 108×108. -->
  <group
      android:translateX="24"
      android:translateY="24"
      android:scaleX="0.3"
      android:scaleY="0.3">

    <!-- Каустика: световое пятно ПОД знаком, поэтому слой первый. -->
    <group android:pivotY="163" android:scaleY="0.327586">
      <path android:pathData="M100,105 a58,58 0 1,0 0,116 a58,58 0 1,0 0,-116 Z">
        <aapt:attr name="android:fillColor">
          <gradient
              android:type="radial"
              android:centerX="100"
              android:centerY="163"
              android:gradientRadius="58">
            <item android:offset="0" android:color="@color/warm_mark_caustic_light" />
            <item android:offset="1" android:color="@color/warm_mark_caustic_clear" />
          </gradient>
        </aapt:attr>
      </path>
    </group>

    <!-- Тело: радиальный градиент, смещённый в верхний левый угол. -->
    <path android:pathData="M100,14 a86,86 0 1,0 0,172 a86,86 0 1,0 0,-172 Z">
      <aapt:attr name="android:fillColor">
        <gradient
            android:type="radial"
            android:centerX="72.48"
            android:centerY="62.16"
            android:gradientRadius="134.16">
          <item android:offset="0" android:color="@color/warm_mark_body_light_0" />
          <item android:offset="0.52" android:color="@color/warm_mark_body_light_1" />
          <item android:offset="1" android:color="@color/warm_mark_body_light_2" />
        </gradient>
      </aapt:attr>
    </path>

    <!-- Ободок: линейный градиент наискось — свет идёт сверху слева. -->
    <path
        android:pathData="M100,14 a86,86 0 1,0 0,172 a86,86 0 1,0 0,-172 Z"
        android:strokeWidth="3.5">
      <aapt:attr name="android:strokeColor">
        <gradient
            android:type="linear"
            android:startX="44.96"
            android:startY="27.76"
            android:endX="161.92"
            android:endY="175.68">
          <item android:offset="0" android:color="@color/warm_mark_rim_light_0" />
          <item android:offset="0.46" android:color="@color/warm_mark_rim_light_1" />
          <item android:offset="1" android:color="@color/warm_mark_rim_light_2" />
        </gradient>
      </aapt:attr>
    </path>

    <!-- Три кольца: толщина убывает к центру, плотность нарастает. -->
    <path
        android:pathData="M100,34 a66,66 0 1,0 0,132 a66,66 0 1,0 0,-132 Z"
        android:strokeColor="@color/warm_mark_ink_on_light"
        android:strokeAlpha="0.09"
        android:strokeWidth="7" />
    <path
        android:pathData="M100,53 a47,47 0 1,0 0,94 a47,47 0 1,0 0,-94 Z"
        android:strokeColor="@color/warm_mark_ink_on_light"
        android:strokeAlpha="0.2"
        android:strokeWidth="2" />
    <path
        android:pathData="M100,72 a28,28 0 1,0 0,56 a28,28 0 1,0 0,-56 Z"
        android:strokeColor="@color/warm_mark_ink_on_light"
        android:strokeAlpha="0.42"
        android:strokeWidth="2.5" />

    <!-- Световой серп по верхнему краю: кольцевой сектор 76/67. -->
    <path
        android:pathData="M25.1,86.8 A76,76 0 0 1 86.8,25.1 L88.4,34 A67,67 0 0 0 34,88.4 Z"
        android:fillColor="@color/warm_mark_highlight"
        android:fillAlpha="0.95" />

    <!-- Тёплая дуга преломлённого луча: она одна и та же в обоих вариантах. -->
    <path
        android:pathData="M180.8,129.4 A86,86 0 0 1 114.9,184.7"
        android:strokeColor="@color/warm_mark_accent"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <!-- Центральная точка. -->
    <path
        android:pathData="M100,92 a8,8 0 1,0 0,16 a8,8 0 1,0 0,-16 Z"
        android:fillColor="@color/warm_mark_ink_on_light"
        android:fillAlpha="0.72" />
  </group>
</vector>
