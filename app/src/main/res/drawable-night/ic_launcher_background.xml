<!--
  Подложка адаптивной иконки в тёмной системной теме: светлая плитка.
  Там, где система рисует иконку на тёмном фоне, тёмная плитка сливается с ним.

  Подложка адаптивной иконки заливается целиком: система обрежет её своей маской —
  круглой, квадратной со скруглением или фирменной EMUI, — и любой незалитый угол
  вылез бы ровно на той маске, которой не было под рукой.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <path
      android:pathData="M0,0 h108 v108 h-108 z"
      android:fillColor="@color/mark_tile_light" />
</vector>
