<?xml version="1.0" encoding="utf-8"?>
<!--
  Разрешения подсистемы напоминаний (SKL-13, таблица НАП-15).

  Разрешение INTERNET не объявляется никогда (ПЛ-3, НФТ-15), и это проверяется на собранном
  артефакте после слияния манифестов, а не здесь: разрешение способна добавить зависимость.
  Именно так пришло ACCESS_NETWORK_STATE от androidx.work — и снято ниже.

  Тема запускаемой Activity — тема заставки (SKL-21): полотно и знак первого кадра
  рисует система по теме окна, ещё до создания Activity. Приложение переключается
  в свою тему само, через postSplashScreenTheme.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Разрешение состояния сети снимается из слитого манифеста (ПЛ-3, НФТ-15).

      Откуда оно приходит: `androidx.work` объявляет ACCESS_NETWORK_STATE в своём манифесте —
      библиотеке оно нужно для задач с сетевыми ограничениями. У нас таких задач нет ни одной
      (перепланирование будильников выполняется без ограничений, `Constraints.NONE`), и продукт
      обещает человеку, что сеть не требуется вовсе. Разрешение, видимое в магазине рядом
      с этим обещанием, — прямое противоречие, а не формальность.

      Снятие безопасно, и это проверено по исходникам библиотеки 2.9.1, а не предположено:
      `NetworkStateTracker` получает `ConnectivityManager` в конструкторе (это не требует
      разрешения), а `registerDefaultNetworkCallback` вызывается только из `startTracking()`,
      то есть когда появляется задача с сетевым ограничением; `ConstraintController`
      обращается к состоянию сети лишь после проверки `hasConstraint(workSpec)`. Дополнительно
      сама библиотека перехватывает `SecurityException` в этих местах (b/153246136, b/163342798).
      Инвариант «ни одной задачи с сетевым ограничением» держится тестом `ReminderWorkTest`.

      FOREGROUND_SERVICE и WAKE_LOCK от библиотеки остаются: второе нужно по делу — работа
      идёт сразу после будильника, разбудившего устройство; первое не используется вовсе
      (задача помечается `expedited` только на Android 12+, где служба переднего плана
      не применяется), но снятие разрешения не убрало бы объявленную библиотекой службу
      и превратило бы любой её будущий запуск из заметного уведомления в отказ с исключением
      посреди восстановления напоминаний.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Показ уведомлений; на Android 13+ спрашивается у человека (НАП-15). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Точные будильники: объявляются оба разрешения (НАП-16).

      USE_EXACT_ALARM — основное: приложение является календарём приёма лекарств, то есть
      ровно тем случаем, для которого разрешение предназначено; оно выдаётся при установке
      и не требует хождения в настройки. SCHEDULE_EXACT_ALARM — запасной путь на сборках
      и прошивках, где первое не отрабатывает.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Перепланирование после перезагрузки: без него после первой же перезагрузки
         напоминаний нет совсем (ПЛ-9, НФТ-2). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Полноэкранное напоминание поверх экрана блокировки (НАП-29). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Тактильный канал напоминания (НАП-24). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Видимость системного менеджера EMUI (SKL-14, ПЛ-18).

      Нужна, чтобы открыть экран «Настройки → Батарея → Запуск приложений»: с Android 11
      приложение не видит чужих пакетов, и попытка открыть их Activity завершается отказом
      независимо от того, есть ли она на устройстве.

      Именно один пакет, а не QUERY_ALL_PACKAGES: перечисление всех пакетов не даёт состояния
      настройки автозапуска (оно в публичный API не выставлено, НАП-20) и потребовало бы
      объяснений ревью магазина. Отсутствие этого экрана на прошивке — обычный исход,
      и на него есть запасной путь: текстовая инструкция с названиями пунктов меню.
    -->
    <queries>
        <package android:name="com.huawei.systemmanager" />
    </queries>

    <application
        android:name=".SklyankaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Sklyanka">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Sklyanka.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Ярлык запуска на диагностику напоминаний.

              Постоянная точка входа — пункт настроек «Разрешения и автозапуск» (SKL-20,
              ОВ-48); до неё экран диагностики иначе недостижим, а именно он отвечает
              на вопрос «почему напоминание не пришло» (НАП-37).
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Полноэкранное напоминание (НАП-29).

          showWhenLocked и turnScreenOn — на API 27 и выше; на 26 те же свойства включаются
          флагами окна в самой Activity (minSdk 26, ПЛ-1).
          excludeFromRecents: карточка приёма не остаётся в списке недавних — вернуться
          к напоминанию через список задач нечего, а приём в нём выглядел бы отдельным
          экраном приложения.
        -->
        <activity
            android:name="ru.stohastika.sklyanka.feature.reminder.ReminderActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Sklyanka"
            android:turnScreenOn="true" />

        <!--
          Диагностика напоминаний (НАП-37).

          exported="true" без фильтра намерений: постоянного входа в неё ещё нет (ОВ-48,
          SKL-20), а пройти чек-лист устройства (НАП-40) и открыть отчёт руками нужно уже
          сейчас — ярлык запуска и прямой запуск командой это дают. Медицинских данных
          на экране нет по построению (НФТ-19), поэтому цена открытости здесь нулевая.
          Когда пункт настроек появится, атрибут снимается.
        -->
        <activity
            android:name="ru.stohastika.sklyanka.feature.reminder.DiagnosticsActivity"
            android:exported="true"
            android:label="@string/diagnostics_shortcut_label"
            android:theme="@style/Theme.Sklyanka" />

        <!--
          Экран разрешений EMUI при повторном входе (SKL-14, НАП-21).

          Первый запуск открывает тот же экран внутри MainActivity — это шаг онбординга,
          а не отдельное окно. Отдельная Activity нужна повторному входу: постоянная точка
          входа — пункт настроек «Разрешения и автозапуск» (SKL-20), и решение, один это экран
          с диагностикой или два разных, не принято (ОВ-48). До ответа экран достижим ярлыком
          запуска — ровно как диагностика, и по той же причине: экран, до которого нельзя
          добраться, не отвечает ни на один вопрос человека, у которого не приходят напоминания.

          exported="true" без фильтра намерений — чтобы ярлык и прямой запуск командой
          работали до появления пункта настроек. Медицинских данных на экране нет
          по построению (НФТ-19). Когда пункт настроек появится, атрибут снимается.
        -->
        <activity
            android:name="ru.stohastika.sklyanka.feature.onboarding.PermissionsActivity"
            android:exported="true"
            android:label="@string/permissions_shortcut_label"
            android:theme="@style/Theme.Sklyanka" />

        <!--
          Сработавший будильник: показ напоминания, якорь и пробное напоминание.

          exported="false": будильники ставит само приложение, и снаружи их присылать
          некому — открытый приёмник напоминаний означал бы чужие карточки приёма.
        -->
        <receiver
            android:name=".reminder.AlarmReceiver"
            android:exported="false" />

        <!--
          Системные события, после которых будильников больше нет (НАП-11).

          exported="true" обязателен: события присылает система, а не приложение.
          QUICKBOOT_POWERON — фирменное событие завершения загрузки на части прошивок,
          где штатный BOOT_COMPLETED до приёмника не доходит.
        -->
        <receiver
            android:name=".reminder.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
