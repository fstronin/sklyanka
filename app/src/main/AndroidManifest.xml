<?xml version="1.0" encoding="utf-8"?>
<!--
  Разрешения подсистемы напоминаний (SKL-13, таблица НАП-15).

  ПМ-31: первая публикация выходит без сетевого контура — Huawei-аналитика и A/B
  убраны из релиза. Сетевых разрешений у приложения нет: `INTERNET` не объявляется,
  разрешения состояния сети запрещены и проверяются на собранном артефакте после
  слияния манифестов, а не здесь: именно так приходило `ACCESS_NETWORK_STATE`
  от `androidx.work` — и снято ниже.

  Тема запускаемой Activity — тема заставки (SKL-21): полотно и знак первого кадра
  рисует система по теме окна, ещё до создания Activity. Приложение переключается
  в свою тему само, через postSplashScreenTheme.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Разрешение состояния сети снимается из слитого манифеста (ПЛ-3, НФТ-15, ПМ-31).

      Откуда оно приходит: `androidx.work` объявляет ACCESS_NETWORK_STATE в своём
      манифесте — библиотеке оно нужно для задач с сетевыми ограничениями, а у нас
      таких задач нет (перепланирование будильников идёт с `Constraints.NONE`).
      Разрешение, видимое в магазине рядом с обещанием «данные не покидают
      устройство», — прямое противоречие, а не формальность.

      Снятие безопасно, и это проверено по исходникам библиотеки 2.9.1, а не предположено:
      `NetworkStateTracker` получает `ConnectivityManager` в конструкторе (это не требует
      разрешения), а `registerDefaultNetworkCallback` вызывается только из `startTracking()`,
      то есть когда появляется задача с сетевым ограничением; `ConstraintController`
      обращается к состоянию сети лишь после проверки `hasConstraint(workSpec)`. Дополнительно
      сама библиотека перехватывает `SecurityException` в этих местах (b/153246136, b/163342798).
      Инвариант «ни одной задачи с сетевым ограничением» держится тестом `ReminderWorkTest`.

      FOREGROUND_SERVICE и WAKE_LOCK от библиотеки остаются: второе нужно по делу — работа
      идёт сразу после будильника, разбудившего устройство; первое не используется вовсе
      (задача помечается `expedited` только на Android 12+, где служба переднего плана
      не применяется), но снятие разрешения не убрало бы объявленную библиотекой службу
      и превратило бы любой её будущий запуск из заметного уведомления в отказ с исключением
      посреди восстановления напоминаний.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
      Рекламный идентификатор запрещён (ПМ-17 п. 4). Разрешение снимается из слитого
      манифеста, если его принесёт любая зависимость, а проверка манифеста валит сборку,
      если оно вернётся. Рекламные идентификаторы не используются ни при каких условиях.
    -->
    <uses-permission
        android:name="com.google.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Показ уведомлений; на Android 13+ спрашивается у человека (НАП-15). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Доступ к политике «Не беспокоить» (НАП-17, ОВ-126/ОВ-134).

      Без объявления этого разрешения приложение не попадает в системный список
      «Доступ к режиму „Не беспокоить“»: человек не может выдать доступ, проверка
      `isNotificationPolicyAccessGranted` всегда возвращает `false`, и строка
      диагностики навсегда остаётся «проверьте вручную» — исправить её нечем.
      Разрешение обычное (protection level normal): диалога не показывает, доступ
      выдаётся вручную на системном экране, куда ведёт «Исправить» в диагностике.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      Точные будильники: объявляются оба разрешения (НАП-16).

      USE_EXACT_ALARM — основное: приложение является календарём приёма лекарств, то есть
      ровно тем случаем, для которого разрешение предназначено; оно выдаётся при установке
      и не требует хождения в настройки. SCHEDULE_EXACT_ALARM — запасной путь на сборках
      и прошивках, где первое не отрабатывает.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Перепланирование после перезагрузки: без него после первой же перезагрузки
         напоминаний нет совсем (ПЛ-9, НФТ-2). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Полноэкранное напоминание поверх экрана блокировки (НАП-29). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Тактильный канал напоминания (НАП-24). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Видимость системного менеджера EMUI (SKL-14, ПЛ-18).

      Нужна, чтобы открыть экран «Настройки → Батарея → Запуск приложений»: с Android 11
      приложение не видит чужих пакетов, и попытка открыть их Activity завершается отказом
      независимо от того, есть ли она на устройстве.

      Именно один пакет, а не QUERY_ALL_PACKAGES: перечисление всех пакетов не даёт состояния
      настройки автозапуска (оно в публичный API не выставлено, НАП-20) и потребовало бы
      объяснений ревью магазина. Отсутствие этого экрана на прошивке — обычный исход,
      и на него есть запасной путь: текстовая инструкция с названиями пунктов меню.
    -->
    <queries>
        <package android:name="com.huawei.systemmanager" />

        <!--
          Системный выбор места для файла отчёта (SKL-46).

          Перед запуском SAF приложение спрашивает `resolveActivity`, чтобы отсутствие
          обработчика было честным отказом, а не падением. С Android 11 запросы
          видимости фильтруются, и без этого объявления проверка не увидела бы
          `DocumentsUI` даже там, где он есть, — сохранение файла было бы объявлено
          недоступным на любом телефоне.
        -->
        <intent>
            <action android:name="android.intent.action.CREATE_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="application/pdf" />
        </intent>

        <!-- Тот же обработчик нужен для файла журнала срабатываний (НФТ-51, SKL-106). -->
        <intent>
            <action android:name="android.intent.action.CREATE_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="text/csv" />
        </intent>
    </queries>

    <application
        android:name=".SklyankaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Sklyanka">

        <!--
          launchMode="singleTask": ярлык быстрого доступа обязан вывести уже существующую
          задачу на передний план и прийти в `onNewIntent`, а не поднять вторую копию
          корня с формой поверх первой (SKL-80). Обычный запуск с иконки поведение
          не меняет.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Sklyanka.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Ярлык быстрого доступа «Добавить лекарство» (SKL-80, ОВ-96): один ярлык —
              самое частое действие, форма нового лекарства. Служебные ярлыки разрешений
              и диагностики убраны: их экраны достижимы строками настроек (ОВ-48/ОВ-49).
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          Полноэкранное напоминание (НАП-29).

          showWhenLocked и turnScreenOn — на API 27 и выше; на 26 те же свойства включаются
          флагами окна в самой Activity (minSdk 26, ПЛ-1).
          excludeFromRecents: карточка приёма не остаётся в списке недавних — вернуться
          к напоминанию через список задач нечего, а приём в нём выглядел бы отдельным
          экраном приложения.
        -->
        <activity
            android:name="ru.stohastika.sklyanka.feature.reminder.ReminderActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Sklyanka"
            android:turnScreenOn="true" />

        <!--
          Карточка самопроверки доставки (SKL-86, ОВ-108).

          Своя Activity рядом с боевой карточкой: тестовое срабатывание показывается
          поверх блокировки тем же полноэкранным намерением, но не притворяется приёмом —
          действий отметки у него нет. Свойства окна те же, что у ReminderActivity;
          on 26 флаги окна ставятся в самой Activity (minSdk 26, ПЛ-1).
        -->
        <activity
            android:name="ru.stohastika.sklyanka.feature.reminder.DeliveryCheckActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Sklyanka"
            android:turnScreenOn="true" />

        <!--
          Диагностика напоминаний (НАП-37).

          Постоянный вход — строка настроек «Проверка напоминаний» (ОВ-49, SKL-79);
          ярлыка запуска у экрана больше нет (SKL-80). exported="true" пока остаётся:
          на прямой запуск опираются прогоны устройством (НАП-40, SKL-27), а вопрос
          снятия атрибута — отдельный. Медицинских данных на экране нет по построению
          (НФТ-19), поэтому цена открытости нулевая.

          `adjustResize` — чтобы окно не «уезжало» вверх при показе клавиатуры: инсеты
          IME обрабатывает сама шторка (`SklyankaBottomSheet`), а `adjustPan` сдвинул бы
          полотно и оставил полосу над клавиатурой (ОВ-140).
        -->
        <activity
            android:name="ru.stohastika.sklyanka.feature.reminder.DiagnosticsActivity"
            android:exported="true"
            android:label="@string/diagnostics_shortcut_label"
            android:theme="@style/Theme.Sklyanka"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Экран разрешений EMUI при повторном входе (SKL-14, НАП-21).

          Первый запуск открывает тот же экран внутри MainActivity — это шаг онбординга,
          а не отдельное окно. Отдельная Activity нужна повторному входу: постоянная точка
          входа — строка настроек «Разрешения и автозапуск» (SKL-20); ярлыка запуска у экрана
          больше нет (SKL-80).

          exported="true" без фильтра намерений пока остаётся: на прямой запуск опираются
          прогоны устройством. Медицинских данных на экране нет по построению (НФТ-19).
          Когда прямой запуск перестанет быть нужен, атрибут снимается.
        -->
        <activity
            android:name="ru.stohastika.sklyanka.feature.onboarding.PermissionsActivity"
            android:exported="true"
            android:label="@string/permissions_shortcut_label"
            android:theme="@style/Theme.Sklyanka" />

        <!--
          Сработавший будильник: показ напоминания, якорь и граница суток.

          exported="false": будильники ставит само приложение, и снаружи их присылать
          некому — открытый приёмник напоминаний означал бы чужие карточки приёма.
        -->
        <receiver
            android:name=".reminder.AlarmReceiver"
            android:exported="false" />

        <!--
          Системные события, после которых будильников больше нет (НАП-11).

          exported="true" обязателен: события присылает система, а не приложение.
          QUICKBOOT_POWERON — фирменное событие завершения загрузки на части прошивок,
          где штатный BOOT_COMPLETED до приёмника не доходит.
        -->
        <receiver
            android:name=".reminder.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <!--
              Выдача права на точные будильники (SKL-85, НАП-16, И-20). Доставку события
              гарантирует не всякая прошивка: при недоставке план восстановит ближайший
              запуск, и это штатный путь восстановления, а не дефект.
            -->
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          Загрузка без разблокировки и разблокировка (SKL-87).

          directBootAware="true" обязателен: до первой разблокировки система запускает только
          такие компоненты. RECEIVE_BOOT_COMPLETED уже объявлен; оба broadcast'а защищённые,
          шлёт только система, поэтому exported="true" безопасен.
        -->
        <receiver
            android:name=".reminder.DirectBootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>

        <!--
          Отдача PDF-отчёта врачу системному обмену (SKL-33, НФТ-17).

          Файл лежит в приватном кеше приложения; получателю выдаётся доступ только
          на чтение и только к одному файлу. Разрешений на внешнее хранилище у
          приложения нет, и общедоступного каталога оно не касается вовсе.

          exported="false": провайдер открывает сам продукт, снаружи к нему ходить некому.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
