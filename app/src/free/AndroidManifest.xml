<?xml version="1.0" encoding="utf-8"?>
<!--
  Поставляемая сборка работает офлайн: состояние сети ей не нужно.

  `androidx.work` объявляет разрешение состояния сети своим манифестом — библиотеке оно
  нужно для задач с сетевыми ограничениями, а у нас таких задач нет: перепланирование
  будильников идёт с `Constraints.NONE`, и инвариант держится тестом `ReminderWorkTest`.
  Снятие безопасно и проверено по исходникам библиотеки 2.9.1: `NetworkStateTracker`
  получает `ConnectivityManager` в конструкторе (это не требует разрешения), а
  `registerDefaultNetworkCallback` вызывается только из `startTracking()`, то есть когда
  появляется задача с сетевым ограничением; сама библиотека перехватывает там
  `SecurityException` (b/153246136, b/163342798). Проверка слитого манифеста валит
  сборку, если разрешение вернётся.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
</manifest>
