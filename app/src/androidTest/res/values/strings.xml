<?xml version="1.0" encoding="utf-8"?>
<!--
  Строки тестового APK (SKL-96).

  Имя лекарства, которое экранная проверка устройства заводит на образе. Русский текст
  живёт здесь, а не в Kotlin: продуктовое правило «строки — в ресурсах» не отменяется
  для тестов. Имя нейтральное (не медицинские данные) и уникальное — кадры прогона
  не должны сталкиваться с прежними записями.
-->
<resources>
    <string name="device_test_medication_name">Стенд %1$s</string>
    <!--
      Имя профиля владельца, которого сеет тестовый граф до запуска Activity (SKL-97).
      Русский текст — в ресурсах, как и у имени лекарства.
    -->
    <string name="device_test_profile_name">Стенд</string>
    <!--
      Сид сценариев волны (SKL-97): нейтральные имена состояний. Русский текст — в ресурсах;
      в кадрах нет медицинских данных.
    -->
    <string name="device_test_medication_due">Стенд Приём</string>
    <string name="device_test_medication_card">Стенд Карточка</string>
    <string name="device_test_medication_edit">Стенд Правка</string>
    <string name="device_test_medication_edit_renamed">Стенд После правки</string>
    <string name="device_test_group_medication">Стенд Группа %1$d</string>
    <!--
      Имена волны 3 (SKL-98): курс архива и курс карточки напоминания. Нейтральные,
      без медицинских данных.
    -->
    <string name="device_test_medication_archive">Стенд Архив</string>
    <string name="device_test_medication_reminder">Стенд Напоминание</string>
</resources>
