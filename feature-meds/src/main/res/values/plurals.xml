<?xml version="1.0" encoding="utf-8"?>
<!--
  Числительные экранов лекарств (НФТ-44).

  Русский требует три формы — «1 раз», «2 раза», «5 раз», — и собрать их
  конкатенацией нельзя: получится «5 раз в сутки» рядом с «2 раз в сутки».
-->
<resources>

    <!-- Частота приёма в строке описания карточки: «1 раз в сутки», «2 раза в сутки». -->
    <plurals name="times_per_day">
        <item quantity="one">%1$d раз в сутки</item>
        <item quantity="few">%1$d раза в сутки</item>
        <item quantity="many">%1$d раз в сутки</item>
        <item quantity="other">%1$d раза в сутки</item>
    </plurals>

    <!-- Ограничение приёма по потребности: «не чаще 3 раз в сутки». -->
    <plurals name="max_per_day">
        <item quantity="one">не чаще %1$d раза в сутки</item>
        <item quantity="few">не чаще %1$d раз в сутки</item>
        <item quantity="many">не чаще %1$d раз в сутки</item>
        <item quantity="other">не чаще %1$d раза в сутки</item>
    </plurals>

    <!-- Остаток упаковки: единица следует за формой выпуска. -->
    <plurals name="stock_left_tablets">
        <item quantity="one">осталась %1$d таблетка</item>
        <item quantity="few">осталось %1$d таблетки</item>
        <item quantity="many">осталось %1$d таблеток</item>
        <item quantity="other">осталось %1$d таблетки</item>
    </plurals>
    <plurals name="stock_left_capsules">
        <item quantity="one">осталась %1$d капсула</item>
        <item quantity="few">осталось %1$d капсулы</item>
        <item quantity="many">осталось %1$d капсул</item>
        <item quantity="other">осталось %1$d капсулы</item>
    </plurals>
    <plurals name="stock_left_millilitres">
        <item quantity="one">остался %1$d мл</item>
        <item quantity="few">осталось %1$d мл</item>
        <item quantity="many">осталось %1$d мл</item>
        <item quantity="other">осталось %1$d мл</item>
    </plurals>
    <plurals name="stock_left_doses">
        <item quantity="one">осталась %1$d доза</item>
        <item quantity="few">осталось %1$d дозы</item>
        <item quantity="many">осталось %1$d доз</item>
        <item quantity="other">осталось %1$d дозы</item>
    </plurals>

    <!--
      ===== Карточка лекарства (MedCard.dc.html) =====
    -->

    <!--
      Частота в блоке «Расписание»: «2 приёма в сутки» — как в макете.
      От `times_per_day` отличается существительным: в списке лекарств та же частота
      пишется «2 раза в сутки» (строка описания карточки списка).
    -->
    <plurals name="card_intakes_per_day">
        <item quantity="one">%1$d приём в сутки</item>
        <item quantity="few">%1$d приёма в сутки</item>
        <item quantity="many">%1$d приёмов в сутки</item>
        <item quantity="other">%1$d приёма в сутки</item>
    </plurals>

    <!-- Доза одного приёма: «по 1 таблетке», «по 2 таблетки», «по 5 таблеток». -->
    <plurals name="card_dose_tablets">
        <item quantity="one">по %1$s таблетке</item>
        <item quantity="few">по %1$s таблетки</item>
        <item quantity="many">по %1$s таблеток</item>
        <item quantity="other">по %1$s таблетки</item>
    </plurals>
    <plurals name="card_dose_capsules">
        <item quantity="one">по %1$s капсуле</item>
        <item quantity="few">по %1$s капсулы</item>
        <item quantity="many">по %1$s капсул</item>
        <item quantity="other">по %1$s капсулы</item>
    </plurals>
    <plurals name="card_dose_millilitres">
        <item quantity="one">по %1$s мл</item>
        <item quantity="few">по %1$s мл</item>
        <item quantity="many">по %1$s мл</item>
        <item quantity="other">по %1$s мл</item>
    </plurals>
    <plurals name="card_dose_doses">
        <item quantity="one">по %1$s дозе</item>
        <item quantity="few">по %1$s дозы</item>
        <item quantity="many">по %1$s доз</item>
        <item quantity="other">по %1$s дозы</item>
    </plurals>

    <!-- Остаток дней курса: «осталось 17 дней». -->
    <plurals name="card_course_days_left">
        <item quantity="one">осталось %1$d день</item>
        <item quantity="few">осталось %1$d дня</item>
        <item quantity="many">осталось %1$d дней</item>
        <item quantity="other">осталось %1$d дня</item>
    </plurals>

    <!-- Предупреждение о покупке в блоке остатка: «хватит на 4 дня». -->
    <plurals name="card_stock_days_left">
        <item quantity="one">хватит на %1$d день</item>
        <item quantity="few">хватит на %1$d дня</item>
        <item quantity="many">хватит на %1$d дней</item>
        <item quantity="other">хватит на %1$d дня</item>
    </plurals>

    <!-- Счётчик недельной полосы: «12 из 14 приёмов». -->
    <plurals name="card_week_counter">
        <item quantity="one">%1$d из %2$d приёма</item>
        <item quantity="few">%1$d из %2$d приёмов</item>
        <item quantity="many">%1$d из %2$d приёмов</item>
        <item quantity="other">%1$d из %2$d приёма</item>
    </plurals>

    <!--
      ===== Архив курсов (Archive.dc.html) =====

      Итог завершённого курса «7 дней · принято 13 из 14»: склоняется только число дней,
      числитель и знаменатель идут без склоняемого существительного.
    -->
    <plurals name="archive_outcome">
        <item quantity="one">%1$d день · принято %2$d из %3$d</item>
        <item quantity="few">%1$d дня · принято %2$d из %3$d</item>
        <item quantity="many">%1$d дней · принято %2$d из %3$d</item>
        <item quantity="other">%1$d дня · принято %2$d из %3$d</item>
    </plurals>

    <!-- Порог напоминания о покупке: «Когда останется на 5 дней». -->
    <plurals name="stock_threshold_caption">
        <item quantity="one">Когда останется на %1$d день</item>
        <item quantity="few">Когда останется на %1$d дня</item>
        <item quantity="many">Когда останется на %1$d дней</item>
        <item quantity="other">Когда останется на %1$d дня</item>
    </plurals>
</resources>
