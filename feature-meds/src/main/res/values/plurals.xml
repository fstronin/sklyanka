<?xml version="1.0" encoding="utf-8"?>
<!--
  Числительные экранов лекарств (НФТ-44).

  Русский требует три формы — «1 раз», «2 раза», «5 раз», — и собрать их
  конкатенацией нельзя: получится «5 раз в сутки» рядом с «2 раз в сутки».
-->
<resources>

    <!-- Частота приёма в строке описания карточки: «1 раз в сутки», «2 раза в сутки». -->
    <plurals name="times_per_day">
        <item quantity="one">%1$d раз в сутки</item>
        <item quantity="few">%1$d раза в сутки</item>
        <item quantity="many">%1$d раз в сутки</item>
        <item quantity="other">%1$d раза в сутки</item>
    </plurals>

    <!-- Ограничение приёма по потребности: «не чаще 3 раз в сутки». -->
    <plurals name="max_per_day">
        <item quantity="one">не чаще %1$d раза в сутки</item>
        <item quantity="few">не чаще %1$d раз в сутки</item>
        <item quantity="many">не чаще %1$d раз в сутки</item>
        <item quantity="other">не чаще %1$d раза в сутки</item>
    </plurals>

    <!--
      Остаток упаковки: единица следует за формой выпуска.

      Число и единица разделены неразрывным пробелом (&#160;): «осталось 60 капсул»
      — одно значение, и переносить его по обычному пробелу нельзя (SKL-59).
      Перенос перед числом («осталось» / «60 капсул») остаётся допустимым.
    -->
    <plurals name="stock_left_tablets">
        <item quantity="one">осталась %1$d&#160;таблетка</item>
        <item quantity="few">осталось %1$d&#160;таблетки</item>
        <item quantity="many">осталось %1$d&#160;таблеток</item>
        <item quantity="other">осталось %1$d&#160;таблетки</item>
    </plurals>
    <plurals name="stock_left_capsules">
        <item quantity="one">осталась %1$d&#160;капсула</item>
        <item quantity="few">осталось %1$d&#160;капсулы</item>
        <item quantity="many">осталось %1$d&#160;капсул</item>
        <item quantity="other">осталось %1$d&#160;капсулы</item>
    </plurals>
    <plurals name="stock_left_millilitres">
        <item quantity="one">остался %1$d&#160;мл</item>
        <item quantity="few">осталось %1$d&#160;мл</item>
        <item quantity="many">осталось %1$d&#160;мл</item>
        <item quantity="other">осталось %1$d&#160;мл</item>
    </plurals>
    <plurals name="stock_left_drops">
        <item quantity="one">осталась %1$d&#160;капля</item>
        <item quantity="few">осталось %1$d&#160;капли</item>
        <item quantity="many">осталось %1$d&#160;капель</item>
        <item quantity="other">осталось %1$d&#160;капли</item>
    </plurals>
    <plurals name="stock_left_sprays">
        <item quantity="one">остался %1$d&#160;впрыск</item>
        <item quantity="few">осталось %1$d&#160;впрыска</item>
        <item quantity="many">осталось %1$d&#160;впрысков</item>
        <item quantity="other">осталось %1$d&#160;впрыска</item>
    </plurals>
    <plurals name="stock_left_injections">
        <item quantity="one">осталась %1$d&#160;инъекция</item>
        <item quantity="few">осталось %1$d&#160;инъекции</item>
        <item quantity="many">осталось %1$d&#160;инъекций</item>
        <item quantity="other">осталось %1$d&#160;инъекции</item>
    </plurals>

    <!--
      ===== Карточка лекарства (MedCard.dc.html) =====
    -->

    <!--
      Частота в блоке «Расписание»: «2 приёма в сутки» — как в макете.
      От `times_per_day` отличается существительным: в списке лекарств та же частота
      пишется «2 раза в сутки» (строка описания карточки списка).
    -->
    <plurals name="card_intakes_per_day">
        <item quantity="one">%1$d приём в сутки</item>
        <item quantity="few">%1$d приёма в сутки</item>
        <item quantity="many">%1$d приёмов в сутки</item>
        <item quantity="other">%1$d приёма в сутки</item>
    </plurals>

    <!-- Доза одного приёма: «по 1 таблетке», «по 2 таблетки», «по 5 таблеток». -->
    <plurals name="card_dose_tablets">
        <item quantity="one">по %1$s&#160;таблетке</item>
        <item quantity="few">по %1$s&#160;таблетки</item>
        <item quantity="many">по %1$s&#160;таблеток</item>
        <item quantity="other">по %1$s&#160;таблетки</item>
    </plurals>
    <plurals name="card_dose_capsules">
        <item quantity="one">по %1$s&#160;капсуле</item>
        <item quantity="few">по %1$s&#160;капсулы</item>
        <item quantity="many">по %1$s&#160;капсул</item>
        <item quantity="other">по %1$s&#160;капсулы</item>
    </plurals>
    <plurals name="card_dose_millilitres">
        <item quantity="one">по %1$s&#160;мл</item>
        <item quantity="few">по %1$s&#160;мл</item>
        <item quantity="many">по %1$s&#160;мл</item>
        <item quantity="other">по %1$s&#160;мл</item>
    </plurals>
    <plurals name="card_dose_drops">
        <item quantity="one">по %1$s&#160;капле</item>
        <item quantity="few">по %1$s&#160;капли</item>
        <item quantity="many">по %1$s&#160;капель</item>
        <item quantity="other">по %1$s&#160;капли</item>
    </plurals>
    <plurals name="card_dose_sprays">
        <item quantity="one">по %1$s&#160;впрыску</item>
        <item quantity="few">по %1$s&#160;впрыска</item>
        <item quantity="many">по %1$s&#160;впрысков</item>
        <item quantity="other">по %1$s&#160;впрыска</item>
    </plurals>
    <plurals name="card_dose_injections">
        <item quantity="one">по %1$s&#160;инъекции</item>
        <item quantity="few">по %1$s&#160;инъекции</item>
        <item quantity="many">по %1$s&#160;инъекций</item>
        <item quantity="other">по %1$s&#160;инъекции</item>
    </plurals>

    <!--
      Превью дозы на экране формы: «2 таблетки» — число и единица без предлога,
      в отличие от `card_dose_*` («по 2 таблетки»).
    -->
    <plurals name="preview_dose_tablets">
        <item quantity="one">%1$s&#160;таблетка</item>
        <item quantity="few">%1$s&#160;таблетки</item>
        <item quantity="many">%1$s&#160;таблеток</item>
        <item quantity="other">%1$s&#160;таблетки</item>
    </plurals>
    <plurals name="preview_dose_capsules">
        <item quantity="one">%1$s&#160;капсула</item>
        <item quantity="few">%1$s&#160;капсулы</item>
        <item quantity="many">%1$s&#160;капсул</item>
        <item quantity="other">%1$s&#160;капсулы</item>
    </plurals>
    <plurals name="preview_dose_millilitres">
        <item quantity="one">%1$s&#160;мл</item>
        <item quantity="few">%1$s&#160;мл</item>
        <item quantity="many">%1$s&#160;мл</item>
        <item quantity="other">%1$s&#160;мл</item>
    </plurals>
    <plurals name="preview_dose_drops">
        <item quantity="one">%1$s&#160;капля</item>
        <item quantity="few">%1$s&#160;капли</item>
        <item quantity="many">%1$s&#160;капель</item>
        <item quantity="other">%1$s&#160;капли</item>
    </plurals>
    <plurals name="preview_dose_sprays">
        <item quantity="one">%1$s&#160;впрыск</item>
        <item quantity="few">%1$s&#160;впрыска</item>
        <item quantity="many">%1$s&#160;впрысков</item>
        <item quantity="other">%1$s&#160;впрыска</item>
    </plurals>
    <plurals name="preview_dose_injections">
        <item quantity="one">%1$s&#160;инъекция</item>
        <item quantity="few">%1$s&#160;инъекции</item>
        <item quantity="many">%1$s&#160;инъекций</item>
        <item quantity="other">%1$s&#160;инъекции</item>
    </plurals>

    <!-- Остаток дней курса: «осталось 17 дней». -->
    <plurals name="card_course_days_left">
        <item quantity="one">осталось %1$d день</item>
        <item quantity="few">осталось %1$d дня</item>
        <item quantity="many">осталось %1$d дней</item>
        <item quantity="other">осталось %1$d дня</item>
    </plurals>

    <!-- Предупреждение о покупке в блоке остатка: «хватит на 4 дня». -->
    <plurals name="card_stock_days_left">
        <item quantity="one">хватит на %1$d день</item>
        <item quantity="few">хватит на %1$d дня</item>
        <item quantity="many">хватит на %1$d дней</item>
        <item quantity="other">хватит на %1$d дня</item>
    </plurals>

    <!-- Счётчик недельной полосы: «12 из 14 приёмов». -->
    <plurals name="card_week_counter">
        <item quantity="one">%1$d из %2$d приёма</item>
        <item quantity="few">%1$d из %2$d приёмов</item>
        <item quantity="many">%1$d из %2$d приёмов</item>
        <item quantity="other">%1$d из %2$d приёма</item>
    </plurals>

    <!--
      ===== Архив курсов (Archive.dc.html) =====

      Итог завершённого курса «7 дней · принято 13 из 14»: склоняется только число дней,
      числитель и знаменатель идут без склоняемого существительного.
    -->
    <plurals name="archive_outcome">
        <item quantity="one">%1$d день · принято %2$d из %3$d</item>
        <item quantity="few">%1$d дня · принято %2$d из %3$d</item>
        <item quantity="many">%1$d дней · принято %2$d из %3$d</item>
        <item quantity="other">%1$d дня · принято %2$d из %3$d</item>
    </plurals>

    <!-- Порог напоминания о покупке: «Когда останется на 5 дней». -->
    <plurals name="stock_threshold_caption">
        <item quantity="one">Когда останется на %1$d день</item>
        <item quantity="few">Когда останется на %1$d дня</item>
        <item quantity="many">Когда останется на %1$d дней</item>
        <item quantity="other">Когда останется на %1$d дня</item>
    </plurals>

    <!--
      Слово единицы дозы в поле (docs/norm/06-design.md §5.3): число печатает само поле, а строка
      несёт только слово и согласуется с набранным числом. Пустое поле показывает имя
      единицы — форму `one`. У дозовых семейств `few` и `other` одно слово: дробное число
      печатается количеством «2» (`pluralQuantityOf`), и поле не должно расходиться
      с превью.
    -->
    <plurals name="field_unit_tablets">
        <item quantity="one">таблетка</item>
        <item quantity="few">таблетки</item>
        <item quantity="many">таблеток</item>
        <item quantity="other">таблетки</item>
    </plurals>
    <plurals name="field_unit_capsules">
        <item quantity="one">капсула</item>
        <item quantity="few">капсулы</item>
        <item quantity="many">капсул</item>
        <item quantity="other">капсулы</item>
    </plurals>
    <plurals name="field_unit_millilitres">
        <item quantity="one">мл</item>
        <item quantity="few">мл</item>
        <item quantity="many">мл</item>
        <item quantity="other">мл</item>
    </plurals>
    <plurals name="field_unit_drops">
        <item quantity="one">капля</item>
        <item quantity="few">капли</item>
        <item quantity="many">капель</item>
        <item quantity="other">капли</item>
    </plurals>
    <plurals name="field_unit_sprays">
        <item quantity="one">впрыск</item>
        <item quantity="few">впрыска</item>
        <item quantity="many">впрысков</item>
        <item quantity="other">впрыска</item>
    </plurals>
    <plurals name="field_unit_injections">
        <item quantity="one">инъекция</item>
        <item quantity="few">инъекции</item>
        <item quantity="many">инъекций</item>
        <item quantity="other">инъекции</item>
    </plurals>
</resources>
